<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ evento.nome }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --cor-bg: {{ evento.corBackground ?? '#f8fafc' }};
            --cor-texto: {{ evento.corTexto ?? '#1e293b' }};
            --cor-texto-sec: {{ evento.corTextoSecundario ?? '#64748b' }};
            --cor-btn-primary: {{ evento.corBotaoPrimario ?? '#4f46e5' }};
            --cor-btn-secondary: {{ evento.corBotaoSecundario ?? '#6b7280' }};
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--cor-bg);
            color: var(--cor-texto);
            min-height: 100vh;
        }
        .container { max-width: 800px; margin: 0 auto; padding: 0 1rem; }
        .btn {
            display: inline-flex; align-items: center; gap: .5rem;
            padding: .75rem 1.5rem; border-radius: .5rem; border: none;
            font-size: 1rem; font-weight: 600; cursor: pointer;
            text-decoration: none; transition: all .2s ease;
        }
        .btn-primary {
            background: var(--cor-btn-primary); color: #fff;
        }
        .btn-primary:hover { filter: brightness(1.1); transform: translateY(-1px); box-shadow: 0 4px 12px rgba(0,0,0,.15); }
        .btn-secondary { background: var(--cor-btn-secondary); color: #fff; }
        .btn-secondary:hover { filter: brightness(1.1); }
        .btn-danger { background: #ef4444; color: #fff; padding: .4rem .8rem; font-size: .85rem; border-radius: .375rem; }
        .card { background: rgba(255,255,255,.85); backdrop-filter: blur(8px); border-radius: 1rem; padding: 1.5rem; box-shadow: 0 4px 24px rgba(0,0,0,.08); margin-bottom: 1rem; }
        .banner { width: 100%; max-height: 320px; object-fit: cover; border-radius: 1rem; }
        .logo { height: 60px; width: auto; }
        .valor-badge { font-size: 1.5rem; font-weight: 800; color: var(--cor-btn-primary); }
        .valor-total-big { font-size: 2rem; font-weight: 900; color: var(--cor-btn-primary); }
        .inscrito-row { border-left: 4px solid var(--cor-btn-primary); padding-left: 1rem; }
        table { width: 100%; border-collapse: collapse; }
        th, td { text-align: left; padding: .5rem .75rem; font-size: .9rem; }
        th { font-weight: 600; border-bottom: 2px solid rgba(0,0,0,.1); }
        tr:not(:last-child) td { border-bottom: 1px solid rgba(0,0,0,.06); }
        .flash { padding: .75rem 1rem; border-radius: .5rem; margin-bottom: 1rem; font-size: .9rem; }
        .flash-danger { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }
    </style>
</head>
<body>
    {% block content %}{% endblock %}
</body>
</html>

{% extends 'pub/evento/base_pub.html.twig' %}

{% block content %}
<div class="container" style="padding-top: 2rem; padding-bottom: 3rem;">

    <div style="display: flex; align-items: center; gap: .75rem; margin-bottom: 1.5rem;">
        <a href="{{ path('app_pub_evento_show', {token: evento.token}) }}" style="color: var(--cor-texto-sec); text-decoration: none; font-size: .9rem;">← Voltar</a>
        {% if evento.logoName %}
            <img src="{{ vich_uploader_asset(evento, 'logoFile') }}" alt="{{ evento.nome }}" style="height: 40px; width: auto;">
        {% endif %}
        <h1 style="font-size: 1.4rem; font-weight: 800;">Adicionar Inscrito — {{ evento.nome }}</h1>
    </div>

    {% for message in app.flashes('danger') %}
        <div class="flash flash-danger">⚠️ {{ message }}</div>
    {% endfor %}

    <form method="post" action="{{ path('app_pub_evento_adicionar', {token: evento.token}) }}" id="form-inscricao">

        <div class="card">
            <h2 style="font-size: 1rem; font-weight: 700; margin-bottom: 1rem; color: var(--cor-texto-sec); text-transform: uppercase; letter-spacing: .05em;">Tipo de Inscrição</h2>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                <div style="grid-column: 1 / -1;">
                    <label style="display: block; font-weight: 600; margin-bottom: .35rem;">Tipo de Inscrição *</label>
                    <select name="tipo_inscricao" id="tipo_inscricao" required style="width: 100%; padding: .6rem .75rem; border: 1.5px solid #d1d5db; border-radius: .5rem; font-size: 1rem; background: #fff;">
                        <option value="">— Selecione —</option>
                        {% for tipo in tipos %}
                            <option value="{{ tipo.id }}" data-valor="{{ tipo.valorBase }}">{{ tipo.nome }} — R$ {{ tipo.valorBase|number_format(2, ',', '.') }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <div id="itens-container" style="display: none;">
                <label style="display: block; font-weight: 600; margin-bottom: .5rem;">Itens Adicionais</label>
                <div id="itens-list" style="display: flex; flex-wrap: wrap; gap: .5rem;"></div>
            </div>

            <div style="margin-top: 1rem; padding: .75rem 1rem; background: rgba(0,0,0,.04); border-radius: .5rem; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-weight: 600;">Valor desta inscrição:</span>
                <span id="valor-atual" style="font-size: 1.5rem; font-weight: 900; color: var(--cor-btn-primary);">R$ 0,00</span>
            </div>
        </div>

        <div class="card">
            <h2 style="font-size: 1rem; font-weight: 700; margin-bottom: 1rem; color: var(--cor-texto-sec); text-transform: uppercase; letter-spacing: .05em;">Dados Pessoais</h2>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                {% macro field(name, label, type, required, fullwidth) %}
                    <div style="{{ fullwidth ? 'grid-column: 1 / -1;' : '' }}">
                        <label style="display: block; font-weight: 600; margin-bottom: .35rem; font-size: .9rem;">{{ label }}{{ required ? ' *' : '' }}</label>
                        <input type="{{ type }}" name="{{ name }}" {% if required %}required{% endif %}
                            style="width: 100%; padding: .6rem .75rem; border: 1.5px solid #d1d5db; border-radius: .5rem; font-size: 1rem;">
                    </div>
                {% endmacro %}
                {{ _self.field('nome_completo', 'Nome Completo', 'text', true, true) }}
                {{ _self.field('nome_cracha', 'Nome para o Crachá', 'text', false, false) }}
                {{ _self.field('data_nascimento', 'Data de Nascimento', 'date', false, false) }}
                {{ _self.field('email', 'E-mail', 'email', false, false) }}
                {{ _self.field('cpf', 'CPF', 'text', false, false) }}
                {{ _self.field('whatsapp', 'Whatsapp', 'text', false, false) }}
                {{ _self.field('nome_contato_emergencia', 'Nome do Contato de Emergência', 'text', false, false) }}
                {{ _self.field('telefone_contato_emergencia', 'Telefone de Emergência', 'text', false, false) }}
                {{ _self.field('cidade', 'Cidade', 'text', false, false) }}

                <div>
                    <label style="display: block; font-weight: 600; margin-bottom: .35rem; font-size: .9rem;">Estado</label>
                    <select name="estado" style="width: 100%; padding: .6rem .75rem; border: 1.5px solid #d1d5db; border-radius: .5rem; font-size: 1rem; background: #fff;">
                        <option value="">— UF —</option>
                        {% for uf in ['AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO'] %}
                            <option value="{{ uf }}">{{ uf }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div>
                    <label style="display: block; font-weight: 600; margin-bottom: .35rem; font-size: .9rem;">Possui restrição alimentar?</label>
                    <textarea name="restricao_alimentar" rows="2" style="width: 100%; padding: .6rem .75rem; border: 1.5px solid #d1d5db; border-radius: .5rem; font-size: .95rem; resize: vertical;"></textarea>
                </div>
                <div>
                    <label style="display: block; font-weight: 600; margin-bottom: .35rem; font-size: .9rem;">Possui alguma alergia?</label>
                    <textarea name="alergia" rows="2" style="width: 100%; padding: .6rem .75rem; border: 1.5px solid #d1d5db; border-radius: .5rem; font-size: .95rem; resize: vertical;"></textarea>
                </div>
            </div>
        </div>

        <div class="card">
            <h2 style="font-size: 1rem; font-weight: 700; margin-bottom: 1rem; color: var(--cor-texto-sec); text-transform: uppercase; letter-spacing: .05em;">Termos e Consentimento</h2>

            <div style="display: flex; flex-direction: column; gap: 1rem;">
                <label style="display: flex; gap: .75rem; align-items: flex-start; cursor: pointer;">
                    <input type="checkbox" name="aceite_lgpd" required style="margin-top: .25rem; width: 1.1rem; height: 1.1rem; flex-shrink: 0;">
                    <span style="font-size: .9rem; line-height: 1.5; color: var(--cor-texto-sec);">
                        <strong>Estou ciente</strong> que a minha participação no evento está de acordo com as diretrizes da Lei Geral de Proteção de Dados informada no início desse formulário. *
                    </span>
                </label>

                <label style="display: flex; gap: .75rem; align-items: flex-start; cursor: pointer;">
                    <input type="checkbox" name="aceite_imagem" required style="margin-top: .25rem; width: 1.1rem; height: 1.1rem; flex-shrink: 0;">
                    <span style="font-size: .9rem; line-height: 1.5; color: var(--cor-texto-sec);">
                        <strong>Autorizo</strong> que a Comissão organizadora do evento utilize gratuitamente — pelas redes sociais ou site — imagens, sons, falas dos participantes com o objetivo de divulgação e de arquivamento histórico das memórias do evento. Comprometo-me a não gravar, copiar, compartilhar, publicar ou utilizar de qualquer forma as imagens, sons ou quaisquer outros dados dos demais participantes, nos termos da legislação em vigor. *
                    </span>
                </label>
            </div>
        </div>

        <div style="display: flex; justify-content: flex-end; margin-top: 1.5rem;">
            <button type="submit" class="btn btn-primary" style="font-size: 1.1rem; padding: .9rem 2rem;">
                ✔ Cadastrar Inscrito
            </button>
        </div>
    </form>
</div>

<script>
const tipoSelect = document.getElementById('tipo_inscricao');
const itensContainer = document.getElementById('itens-container');
const itensList = document.getElementById('itens-list');
const valorAtual = document.getElementById('valor-atual');

function formatBRL(v) {
    return 'R$ ' + v.toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.');
}

function calcularTotal() {
    const opt = tipoSelect.selectedOptions[0];
    let total = opt ? parseFloat(opt.dataset.valor || 0) : 0;
    document.querySelectorAll('input[name="itens_adicionais[]"]:checked').forEach(cb => {
        total += parseFloat(cb.dataset.valor || 0);
    });
    valorAtual.textContent = formatBRL(total);
}

tipoSelect.addEventListener('change', async function() {
    const id = this.value;
    itensList.innerHTML = '';
    if (!id) { itensContainer.style.display = 'none'; calcularTotal(); return; }
    try {
        const res = await fetch('/e/api/tipo/' + id + '/itens');
        const itens = await res.json();
        if (itens.length === 0) { itensContainer.style.display = 'none'; calcularTotal(); return; }
        itens.forEach(item => {
            const label = document.createElement('label');
            label.style.cssText = 'display:inline-flex;align-items:center;gap:.4rem;padding:.45rem .85rem;border:1.5px solid #d1d5db;border-radius:2rem;cursor:pointer;font-size:.9rem;transition:all .2s;';
            label.innerHTML = `<input type="checkbox" name="itens_adicionais[]" value="${item.id}" data-valor="${item.valor}" style="width:1rem;height:1rem;"> ${item.descricao} <span style="color:var(--cor-btn-primary);font-weight:700;">+R$ ${item.valor.toFixed(2).replace('.',',')}</span>`;
            label.querySelector('input').addEventListener('change', calcularTotal);
            itensList.appendChild(label);
        });
        itensContainer.style.display = 'block';
        calcularTotal();
    } catch(e) { console.error(e); }
});
</script>
{% endblock %}

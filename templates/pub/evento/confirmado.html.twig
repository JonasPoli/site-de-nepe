{% extends 'pub/evento/base_pub.html.twig' %}

{% block content %}
<div class="container" style="padding-top: 3rem; padding-bottom: 3rem; text-align: center;">

    <div style="font-size: 4rem; margin-bottom: 1rem;">🎉</div>

    {% if evento.logoName %}
        <img src="{{ vich_uploader_asset(evento, 'logoFile') }}" alt="{{ evento.nome }}" style="height: 60px; width: auto; margin: 0 auto 1.5rem; display: block;">
    {% endif %}

    <h1 style="font-size: 2rem; font-weight: 900; margin-bottom: 1rem;">Inscrição Confirmada!</h1>

    {% if mensagem %}
        <div class="card" style="text-align: left; line-height: 1.7; max-width: 600px; margin: 0 auto 2rem;">
            {{ mensagem|raw }}
        </div>
    {% else %}
        <p style="color: var(--cor-texto-sec); font-size: 1.1rem; margin-bottom: 2rem;">
            Obrigado pela sua inscrição em <strong>{{ evento.nome }}</strong>.<br>
            Em breve você receberá mais informações.
        </p>
    {% endif %}

    <a href="{{ path('app_pub_evento_show', {token: evento.token}) }}" class="btn btn-primary" style="font-size: 1rem;">
        ← Voltar ao Evento
    </a>
</div>
{% endblock %}

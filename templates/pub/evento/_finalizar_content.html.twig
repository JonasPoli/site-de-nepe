<div class="container" style="padding-top: 2rem; padding-bottom: 3rem;">

    <div style="text-align: center; margin-bottom: 2rem;">
        {% if evento.logoName %}
            <img src="{{ vich_uploader_asset(evento, 'logoFile') }}" alt="{{ evento.nome }}" style="height: 60px; width: auto; margin: 0 auto 1rem;" id="p-logo-final">
        {% else %}
             <img src="" alt="" style="height: 60px; width: auto; margin: 0 auto 1rem; display: none;" id="p-logo-final">
        {% endif %}
        <h1 style="font-size: 1.75rem; font-weight: 800;">Resumo e Pagamento</h1>
        <p style="color: var(--cor-texto-sec); margin-top: .5rem;" id="p-name-final">{{ evento.nome }}</p>
    </div>

    {# Summary #}
    <div class="card">
        <h2 style="font-size: 1rem; font-weight: 700; margin-bottom: 1rem; color: var(--cor-texto-sec); text-transform: uppercase; letter-spacing: .05em;">Resumo da Inscrição</h2>
        
        {% set dummyInscritos = [{nomeCompleto: 'João Silva', valorTotal: 150.00}] %}
        {% set listInscritos = inscritos ?? (inscricao.inscritos|default(dummyInscritos)) %}
        {% set total = valorTotal|default(150.00) %}

        {% for i in listInscritos %}
            <div style="display: flex; justify-content: space-between; margin-bottom: .5rem; font-size: .95rem; border-bottom: 1px solid rgba(0,0,0,0.05); padding-bottom: .5rem;">
                <span>{{ i.nomeCompleto }}</span>
                <span style="font-weight: 600;">R$ {{ (i.valorTotal ?? 150.00)|number_format(2, ',', '.') }}</span>
            </div>
        {% endfor %}

        <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 1rem;">
            <span style="font-weight: 700; font-size: 1.1rem;">TOTAL A PAGAR:</span>
            <span class="valor-total-big">R$ {{ total|number_format(2, ',', '.') }}</span>
        </div>
    </div>

    {# PIX Payment #}
    <div class="card" style="text-align: center;">
        <h2 style="font-size: 1.2rem; font-weight: 800; margin-bottom: 1.5rem;">💰 Pagamento via Pix</h2>

        <p style="color: var(--cor-texto-sec); margin-bottom: 1rem; font-size: .95rem;">Escaneie o QR Code ou copie a chave Pix abaixo para efetuar o pagamento.</p>

        {% if qrCode|default(false) %}
            <img src="{{ qrCode }}" alt="QR Code Pix" style="max-width: 240px; width: 100%; border-radius: .75rem; box-shadow: 0 4px 16px rgba(0,0,0,.1); margin: 0 auto 1.5rem; display: block;">
        {% else %}
             <div class="w-48 h-48 bg-white border-8 border-white shadow-xl rounded-2xl mx-auto mb-6 flex items-center justify-center">
                <sl-icon name="qr-code" style="font-size: 140px; color: #333"></sl-icon>
            </div>
        {% endif %}

        <div style="background: rgba(0,0,0,.03); border-radius: .75rem; padding: 1rem; margin-bottom: 1rem; word-break: break-all; font-family: monospace; font-size: .8rem; color: var(--cor-texto-sec);" id="pix-code-display">
            {{ pixCode|default('00020126330014BR.GOV.BCB.PIX011112345678909...') }}
        </div>

        <button {% if not is_preview|default(false) %}onclick="copiarPix()" id="btn-copiar"{% endif %} class="btn btn-primary" style="margin: 0 auto; display: inline-flex; border: none; font-family: inherit;">
            📋 Copiar Chave Pix
        </button>
        {% if not is_preview|default(false) %}
            <div id="msg-copiado" style="display: none; color: #16a34a; font-weight: 700; margin-top: .75rem; font-size: .95rem;">✅ Chave Pix copiada!</div>
        {% endif %}

        <p style="margin-top: 1.5rem; font-size: .85rem; color: var(--cor-texto-sec);">Valor: <strong>R$ {{ total|number_format(2, ',', '.') }}</strong></p>
    </div>

    {# Final message #}
    <div class="card" style="border-left: 4px solid #16a34a;">
        <h2 style="font-size: 1rem; font-weight: 700; margin-bottom: .5rem; color: #15803d;">Informações Importantes</h2>
        <p style="font-size: .9rem; color: var(--cor-texto-sec);">
            Sua inscrição foi registrada sob o código <strong>#{{ (inscricao.id|default('123')) }}</strong>. 
            O organizador receberá os dados automaticamente após a confirmação do pagamento Pix.
        </p>
    </div>

    <div style="text-align: center; margin-top: 1rem;">
        <{% if is_preview|default(false) %}span{% else %}a href="{{ path('app_pub_evento_show', {token: evento.token}) }}"{% endif %} style="color: var(--cor-texto-sec); font-size: .9rem; text-decoration: none;">← Voltar e adicionar mais inscritos</{% if is_preview|default(false) %}span{% else %}a{% endif %}>
    </div>
</div>

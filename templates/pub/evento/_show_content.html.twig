<div class="container" style="padding-top: 2rem; padding-bottom: 3rem;">

    {# Banner #}
    {% if evento.bannerName %}
        <img src="{{ vich_uploader_asset(evento, 'bannerFile') }}" alt="{{ evento.nome }}" class="banner mb-4" id="p-banner">
    {% else %}
        <img src="" alt="" class="banner mb-4" id="p-banner" style="display: none;">
    {% endif %}

    {# Header #}
    <div class="card" style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem;">
        {% if evento.logoName %}
            <img src="{{ vich_uploader_asset(evento, 'logoFile') }}" alt="{{ evento.nome }}" class="logo" id="p-logo">
        {% else %}
            <img src="" alt="" class="logo" id="p-logo" style="display: none;">
        {% endif %}
        <div>
            <h1 style="font-size: 1.75rem; font-weight: 800; color: var(--cor-texto);" id="p-name">{{ evento.nome }}</h1>
            {% if evento.dataInicio %}
                <p style="color: var(--cor-texto-sec); font-size: .9rem; margin-top: .25rem;">
                    📅 {{ evento.dataInicio|date('d/m/Y') }}{% if evento.dataFim %} até {{ evento.dataFim|date('d/m/Y') }}{% endif %}
                </p>
            {% endif %}
        </div>
    </div>

    {# Description #}
    <div class="card" style="line-height: 1.7; color: var(--cor-texto-sec);" id="p-desc">
        {{ (evento.descricao ?? 'Descrição do evento aqui...')|raw }}
    </div>

    {# Flash messages #}
    {% for message in app.flashes('danger') %}
        <div class="flash flash-danger">⚠️ {{ message }}</div>
    {% endfor %}

    {# Inscritos list simulation if empty #}
    {% set displayInscritos = inscritos ?? [] %}
    {% if displayInscritos|length > 0 or is_preview|default(false) %}
        <div class="card">
            <h2 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 1rem;">Inscritos adicionados</h2>

            {% set currentInscritos = displayInscritos|length > 0 ? displayInscritos : [{nomeCompleto: 'João Silva', tipoNome: 'Inscrição Padrão', valorTotal: 150.00}] %}
            
            {% set valorGrandTotal = 0 %}
            {% for idx, i in currentInscritos %}
                {% set valorGrandTotal = valorGrandTotal + i.valorTotal %}
                <div class="inscrito-row" style="margin-bottom: 1rem;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: .5rem;">
                        <div>
                            <p style="font-weight: 700;">{{ i.nomeCompleto }}</p>
                            <p style="font-size: .85rem; color: var(--cor-texto-sec);">
                                {{ i.tipoNome }}
                                {% if i.itensAdicionais|default([])|length > 0 %}
                                    — {% for item in i.itensAdicionais %}{{ item.descricao }}{% if not loop.last %}, {% endif %}{% endfor %}
                                {% endif %}
                            </p>
                        </div>
                        <div style="display: flex; align-items: center; gap: .75rem;">
                            <span class="valor-badge">R$ {{ i.valorTotal|number_format(2, ',', '.') }}</span>
                            {% if not is_preview|default(false) %}
                                <form action="{{ path('app_pub_evento_remover', {token: evento.token, index: idx}) }}" method="post">
                                    <input type="hidden" name="_token" value="{{ csrf_token('remover' ~ idx) }}">
                                    <button type="submit" class="btn btn-danger" title="Remover">✕</button>
                                </form>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}

            <div style="border-top: 2px solid rgba(0,0,0,.08); padding-top: 1rem; margin-top: 1rem; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-weight: 700; font-size: 1rem;">Total de todos os inscritos:</span>
                <span class="valor-total-big">R$ {{ valorGrandTotal|number_format(2, ',', '.') }}</span>
            </div>
        </div>
    {% endif %}

    {# Action buttons #}
    <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1.5rem;">
        {% if evento.status == 'ativo' or is_preview|default(false) %}
            <{% if is_preview|default(false) %}div{% else %}a href="{{ path('app_pub_evento_adicionar', {token: evento.token}) }}"{% endif %} class="btn btn-primary">
                ➕ Adicionar Inscrito
            </{% if is_preview|default(false) %}div{% else %}a{% endif %}>
        {% else %}
            <div style="padding: .75rem 1.5rem; background: #fee2e2; color: #dc2626; border-radius: .5rem; font-weight: 700; border: 1px solid #fecaca;">
                🚫 Inscrições encerradas
            </div>
        {% endif %}

        {% if (inscritos|default([])|length > 0) or is_preview|default(false) %}
            <{% if is_preview|default(false) %}div{% else %}a href="{{ path('app_pub_evento_finalizar', {token: evento.token}) }}"{% endif %} class="btn btn-secondary">
                ✅ Finalizar Inscrições
            </{% if is_preview|default(false) %}div{% else %}a{% endif %}>
        {% endif %}
    </div>
</div>

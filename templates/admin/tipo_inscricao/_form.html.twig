{% extends 'admin/base.html.twig' %}

{% block title %}{{ tipo is defined ? 'Editar Tipo' : 'Novo Tipo de Inscrição' }}{% endblock %}

{% block body %}
<div class="flex items-center justify-between mb-6">
    <div>
        <a href="{{ path('app_admin_tipo_inscricao_index') }}" class="text-slate-500 hover:text-slate-700 text-sm flex items-center gap-1 mb-1">
            <sl-icon name="arrow-left"></sl-icon> Voltar
        </a>
        <h1 class="text-2xl font-bold">{{ tipo is defined ? 'Editar Tipo de Inscrição' : 'Novo Tipo de Inscrição' }}</h1>
    </div>
</div>

{{ form_start(form) }}
<sl-card>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {{ form_row(form.evento) }}
        {{ form_row(form.nome) }}
        {{ form_row(form.valorBase) }}
        {{ form_row(form.status) }}
    </div>
    <div class="flex justify-between mt-6">
        <sl-button href="{{ path('app_admin_tipo_inscricao_index') }}" variant="neutral">Cancelar</sl-button>
        <sl-button type="submit" variant="primary">
            <sl-icon slot="prefix" name="check-circle"></sl-icon>
            Salvar
        </sl-button>
    </div>
</sl-card>
{{ form_end(form) }}
{% endblock %}

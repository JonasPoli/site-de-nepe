{% extends 'admin/nepe_base.html.twig' %}
{% block title %}Mensagens{% endblock %}
{% block page_title %}Mensagens{% endblock %}

{% block body %}
<div class="msg-layout">
    {# Left — thread list #}
    <div class="msg-sidebar">
        {% if isAdmin %}
        <div style="border-bottom:1px solid var(--border);padding:.75rem 1rem;font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)">
            Todas as conversas
        </div>
        <div class="thread-list" id="all-threads">
            {% for msg in allMessages %}
                {% include 'admin/message/_thread_item.html.twig' with {msg, currentUser: app.user} %}
            {% else %}
                <div class="empty-threads">Nenhuma mensagem.</div>
            {% endfor %}
        </div>
        {% else %}
        <div style="border-bottom:1px solid var(--border)">
            <div style="display:flex">
                <button class="tab-btn active" data-tab="received" onclick="switchTab(this,'received')">Recebidas</button>
                <button class="tab-btn" data-tab="sent" onclick="switchTab(this,'sent')">Enviadas</button>
            </div>
        </div>
        <div class="thread-list" id="tab-received">
            {% for msg in receivedMessages %}
                {% include 'admin/message/_thread_item.html.twig' with {msg, currentUser: app.user} %}
            {% else %}
                <div class="empty-threads">Nenhuma mensagem recebida.</div>
            {% endfor %}
        </div>
        <div class="thread-list" id="tab-sent" style="display:none">
            {% for msg in sentMessages %}
                {% include 'admin/message/_thread_item.html.twig' with {msg, currentUser: app.user} %}
            {% else %}
                <div class="empty-threads">Nenhuma mensagem enviada.</div>
            {% endfor %}
        </div>
        {% endif %}
    </div>

    {# Right — conversation view (AJAX) #}
    <div class="msg-main" id="msg-main">
        <div class="msg-placeholder">
            <sl-icon name="chat-dots" style="font-size:3rem;color:var(--muted)"></sl-icon>
            <p>Selecione uma conversa</p>
        </div>
    </div>
</div>

{# New message dialog #}
<sl-dialog label="Nova Mensagem" id="new-msg-dialog">
    <div class="af">
        <div class="af-field">
            <label>Destinatário (username)</label>
            <input type="text" id="msg-recipient-input" class="ai" placeholder="username">
            <input type="hidden" id="msg-recipient-id">
        </div>
        <div class="af-field">
            <label>Assunto</label>
            <input type="text" id="msg-subject" class="ai" placeholder="Assunto">
        </div>
        <div class="af-field">
            <label>Mensagem <span class="req">*</span></label>
            <textarea id="msg-content" class="ate" rows="5" placeholder="Digite sua mensagem…"></textarea>
        </div>
    </div>
    <div slot="footer" style="display:flex;gap:.75rem">
        <button class="btn btn-p" onclick="sendNewMessage()"><sl-icon name="send-fill"></sl-icon> Enviar</button>
        <sl-button variant="neutral" onclick="document.getElementById('new-msg-dialog').hide()">Cancelar</sl-button>
    </div>
</sl-dialog>

<div style="position:fixed;bottom:1.5rem;right:1.5rem">
    <button class="btn btn-p" onclick="document.getElementById('new-msg-dialog').show()" style="box-shadow:0 8px 32px rgba(79,110,247,.4)">
        <sl-icon name="pencil-square"></sl-icon> Nova Mensagem
    </button>
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.msg-layout{display:grid;grid-template-columns:320px 1fr;height:calc(100vh - 60px - 4rem);gap:0;border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;background:var(--bg2)}
.msg-sidebar{border-right:1px solid var(--border);overflow-y:auto;display:flex;flex-direction:column}
.thread-list{flex:1;overflow-y:auto}
.thread-item{padding:1rem;border-bottom:1px solid rgba(255,255,255,.04);cursor:pointer;transition:background var(--ease)}
.thread-item:hover{background:rgba(255,255,255,.04)}
.thread-item.active{background:rgba(79,110,247,.1);border-left:3px solid var(--primary)}
.thread-item.unread .thread-subject{font-weight:700;color:var(--text)}
.thread-subject{font-size:.875rem;font-weight:500;margin-bottom:.25rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.thread-preview{font-size:.78rem;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.thread-meta{display:flex;justify-content:space-between;font-size:.72rem;color:var(--muted);margin-bottom:.35rem}
.empty-threads{padding:2rem;text-align:center;color:var(--muted);font-size:.85rem}
.tab-btn{flex:1;background:none;border:none;border-bottom:2px solid transparent;color:var(--muted);padding:.75rem;font-size:.875rem;font-weight:600;cursor:pointer;transition:all var(--ease)}
.tab-btn.active{color:var(--primary);border-bottom-color:var(--primary)}
.msg-main{overflow-y:auto;display:flex;flex-direction:column}
.msg-placeholder{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1rem;color:var(--muted)}
.conversation{display:flex;flex-direction:column;height:100%}
.conv-header{padding:1rem 1.5rem;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.conv-title{font-weight:700;font-size:1rem}
.conv-messages{flex:1;overflow-y:auto;padding:1.5rem;display:flex;flex-direction:column;gap:1rem}
.msg-bubble{max-width:75%;padding:.85rem 1.1rem;border-radius:12px;font-size:.88rem;line-height:1.6}
.msg-mine{background:rgba(79,110,247,.2);border:1px solid rgba(79,110,247,.3);align-self:flex-end}
.msg-theirs{background:rgba(255,255,255,.06);border:1px solid var(--border);align-self:flex-start}
.msg-sender{font-size:.72rem;color:var(--muted);margin-bottom:.35rem}
.msg-time{font-size:.7rem;color:var(--muted);margin-top:.35rem;text-align:right}
.conv-reply{padding:1rem 1.5rem;border-top:1px solid var(--border);display:flex;gap:.75rem}
.conv-reply textarea{flex:1;min-height:60px;resize:none}
@media(max-width:768px){.msg-layout{grid-template-columns:1fr}}
</style>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
function loadThread(id) {
    document.querySelectorAll('.thread-item').forEach(el => el.classList.remove('active'));
    event.currentTarget.classList.add('active');
    fetch('{{ path('admin_message_index') }}' + '/' + id)
        .then(r => r.text())
        .then(html => {
            document.getElementById('msg-main').innerHTML = html;
        });
}

function switchTab(btn, tab) {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('tab-received').style.display = tab === 'received' ? '' : 'none';
    document.getElementById('tab-sent').style.display = tab === 'sent' ? '' : 'none';
}

function sendNewMessage() {
    const recipientInput = document.getElementById('msg-recipient-input').value;
    const content = document.getElementById('msg-content').value.trim();
    const subject = document.getElementById('msg-subject').value.trim();
    if (!content || !recipientInput) return;

    // Look up user by username (simplification — in production use autocomplete)
    fetch('{{ path('admin_message_send') }}', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({recipient_id: recipientInput, content, subject})
    }).then(r => r.json()).then(data => {
        if (data.status === 'success') {
            document.getElementById('new-msg-dialog').hide();
            location.reload();
        } else {
            alert('Erro: ' + (data.error || 'Desconhecido'));
        }
    });
}

function replyToThread(rootId) {
    const content = document.getElementById('reply-content').value.trim();
    if (!content) return;
    const form = document.getElementById('reply-form');
    form.submit();
}
</script>
{% endblock %}

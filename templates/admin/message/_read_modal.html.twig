<div class="conversation">
    <div class="conv-header">
        <div>
            <div class="conv-title">{{ rootMessage.subject ?? '(sem assunto)' }}</div>
            <div style="font-size:.78rem;color:var(--muted)">
                {{ rootMessage.sender.name }} → {{ rootMessage.recipient.name }}
                · {{ conversation|length }} mensagem(ns)
            </div>
        </div>
    </div>

    <div id="status-banner" style="display:none;padding:.6rem 1.5rem;font-size:.82rem;font-weight:600;background:rgba(34,197,94,.12);color:#4ade80;border-bottom:1px solid rgba(34,197,94,.2)">
        <sl-icon name="check2-circle"></sl-icon> Conversa marcada como resolvida.
    </div>

    <div class="conv-messages" id="conv-messages">
        {% set me = app.user %}
        {% for msg in conversation %}
        <div class="{{ msg.sender.id == me.id ? 'msg-mine' : 'msg-theirs' }} msg-bubble">
            <div class="msg-sender">{{ msg.sender.name }}</div>
            <div>{{ msg.content|nl2br }}</div>
            <div class="msg-time">{{ msg.sentAt|date('d/m/Y H:i') }}</div>
        </div>
        {% endfor %}
    </div>

    <form class="conv-reply" id="reply-form"
          action="{{ path('admin_message_reply', {id: rootMessage.id}) }}" method="post">
        <textarea name="content" id="reply-content" class="ate" rows="2" placeholder="Responder…" style="min-height:60px"></textarea>
        <button type="submit" class="btn btn-p" style="align-self:flex-end">
            <sl-icon name="send-fill"></sl-icon>
        </button>
    </form>
</div>

<script>
document.getElementById('conv-messages').scrollTop = 99999;
document.getElementById('reply-content').addEventListener('keydown', function(e) {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
        document.getElementById('reply-form').submit();
    }
});
</script>

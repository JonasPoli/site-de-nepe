<div class="conversation">
    <div class="conv-header">
        <div>
            <div class="conv-title">{{ rootMessage.subject ?? '(sem assunto)' }}</div>
            <div style="font-size:.78rem;color:var(--muted)">
                {{ rootMessage.sender.name }} → {{ rootMessage.recipient.name }}
                · {{ conversation|length }} mensagem(ns)
            </div>
        </div>
        <div style="display:flex;gap:.5rem">
            <button type="button" class="btn btn-s btn-sm"
                    id="btn-resolve"
                    title="Marcar como resolvido"
                    onclick="setMessageStatus({{ rootMessage.id }}, 'resolved', this)"
                    {% if rootMessage.status == 'resolved' %}disabled style="opacity:.5"{% endif %}>
                <sl-icon name="check2-all"></sl-icon>
                {{ rootMessage.status == 'resolved' ? 'Resolvido ✓' : 'Resolver' }}
            </button>
            <button type="button" class="btn btn-g btn-sm"
                    id="btn-ignore"
                    title="Ignorar conversa"
                    onclick="setMessageStatus({{ rootMessage.id }}, 'ignored', this)"
                    {% if rootMessage.status == 'ignored' %}disabled style="opacity:.5"{% endif %}>
                <sl-icon name="slash-circle"></sl-icon>
            </button>
        </div>
    </div>

    <div id="status-banner" style="display:none;padding:.6rem 1.5rem;font-size:.82rem;font-weight:600;background:rgba(34,197,94,.12);color:#4ade80;border-bottom:1px solid rgba(34,197,94,.2)">
        <sl-icon name="check2-circle"></sl-icon> Conversa marcada como resolvida.
    </div>

    <div class="conv-messages" id="conv-messages">
        {% set me = app.user %}
        {% for msg in conversation %}
        <div class="{{ msg.sender.id == me.id ? 'msg-mine' : 'msg-theirs' }} msg-bubble">
            <div class="msg-sender">{{ msg.sender.name }}</div>
            <div>{{ msg.content|nl2br }}</div>
            <div class="msg-time">{{ msg.sentAt|date('d/m/Y H:i') }}</div>
        </div>
        {% endfor %}
    </div>

    <form class="conv-reply" id="reply-form"
          action="{{ path('admin_message_reply', {id: rootMessage.id}) }}" method="post">
        <textarea name="content" id="reply-content" class="ate" rows="2" placeholder="Responder…" style="min-height:60px"></textarea>
        <button type="submit" class="btn btn-p" style="align-self:flex-end">
            <sl-icon name="send-fill"></sl-icon>
        </button>
    </form>
</div>

<script>
// Scroll to bottom of messages
document.getElementById('conv-messages').scrollTop = 99999;

// Ctrl+Enter to submit reply
document.getElementById('reply-content').addEventListener('keydown', function(e) {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
        document.getElementById('reply-form').submit();
    }
});

function setMessageStatus(id, status, btn) {
    btn.disabled = true;
    btn.style.opacity = '.5';

    fetch('/admin/message/' + id + '/status/' + status, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
    })
    .then(r => r.json())
    .then(data => {
        if (!data.ok) throw new Error('Falha no servidor');

        if (status === 'resolved') {
            // Show success banner inside the conversation panel
            const banner = document.getElementById('status-banner');
            if (banner) banner.style.display = '';

            // Update the btn label
            btn.innerHTML = '<sl-icon name="check2-all"></sl-icon> Resolvido ✓';

            // Dim the thread list item
            const threadEl = document.querySelector('.thread-item.active');
            if (threadEl) {
                threadEl.style.opacity = '.5';
                const subj = threadEl.querySelector('.thread-subject');
                if (subj) subj.style.textDecoration = 'line-through';
            }

            // Disable reply form (conversation closed)
            const replyArea = document.getElementById('reply-content');
            const sendBtn = document.querySelector('#reply-form button[type=submit]');
            if (replyArea) replyArea.disabled = true;
            if (sendBtn) sendBtn.disabled = true;
        }

        if (status === 'ignored') {
            btn.innerHTML = '<sl-icon name="slash-circle"></sl-icon> Ignorado';
            const threadEl = document.querySelector('.thread-item.active');
            if (threadEl) threadEl.style.opacity = '.35';
        }
    })
    .catch(() => {
        btn.disabled = false;
        btn.style.opacity = '';
        alert('Erro ao atualizar status. Tente novamente.');
    });
}
</script>

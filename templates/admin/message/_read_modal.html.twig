<div class="conversation">
    <div class="conv-header">
        <div>
            <div class="conv-title">{{ rootMessage.subject ?? '(sem assunto)' }}</div>
            <div style="font-size:.78rem;color:var(--muted)">
                {{ rootMessage.sender.name }} → {{ rootMessage.recipient.name }}
                · {{ conversation|length }} mensagem(ns)
            </div>
        </div>
    </div>

    <div class="conv-messages" id="conv-messages">
        {% set me = app.user %}
        {% for msg in conversation %}
        <div class="{{ msg.sender.id == me.id ? 'msg-mine' : 'msg-theirs' }} msg-bubble">
            <div class="msg-sender">{{ msg.sender.name }}</div>
            <div>{{ msg.content|nl2br }}</div>
            <div class="msg-time">{{ msg.sentAt|date('d/m/Y H:i') }}</div>
        </div>
        {% endfor %}
    </div>

    <form class="conv-reply" id="reply-form"
          action="{{ path('admin_message_reply', {id: rootMessage.id}) }}" method="post">
        <textarea name="content" id="reply-content" class="ate" rows="2" placeholder="Responder…" style="min-height:60px"></textarea>
        <button type="submit" class="btn btn-p" style="align-self:flex-end">
            <sl-icon name="send-fill"></sl-icon>
        </button>
    </form>
</div>

<style>
.conversation { display:flex; flex-direction:column; height:100%; min-height:0; }
.conv-header  { padding:1rem 1.25rem; border-bottom:1px solid var(--border); flex-shrink:0; background:var(--bg3); }
.conv-title   { font-weight:700; font-size:.95rem; margin-bottom:.2rem; }
.conv-messages {
    flex:1; overflow-y:auto; min-height:0;
    padding:1.25rem 1.25rem;
    display:flex; flex-direction:column; gap:.75rem;
}
.msg-bubble   { max-width:78%; padding:.75rem 1rem; border-radius:12px; font-size:.875rem; line-height:1.6; }
.msg-mine     { background:rgba(79,110,247,.18); border:1px solid rgba(79,110,247,.28); align-self:flex-end; }
.msg-theirs   { background:rgba(255,255,255,.06); border:1px solid var(--border); align-self:flex-start; }
.msg-sender   { font-size:.72rem; color:var(--muted); margin-bottom:.3rem; font-weight:600; }
.msg-time     { font-size:.7rem; color:var(--muted); margin-top:.35rem; text-align:right; }
.conv-reply   {
    padding:1rem 1.25rem;
    border-top:1px solid var(--border);
    display:flex; gap:.75rem; align-items:flex-end;
    flex-shrink:0; background:var(--bg3);
}
.conv-reply textarea { flex:1; min-height:60px; resize:none; border-radius:10px; }
</style>

<script>
document.getElementById('conv-messages').scrollTop = 99999;
document.getElementById('reply-content').addEventListener('keydown', function(e) {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
        document.getElementById('reply-form').submit();
    }
});
</script>

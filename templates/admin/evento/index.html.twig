{% extends 'admin/base.html.twig' %}

{% block title %}Eventos{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.datatables.net/2.1.3/css/dataTables.tailwindcss.min.css">
{% endblock %}

{% block body %}
<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">Eventos</h1>
    <sl-button href="{{ path('app_admin_evento_new') }}" variant="primary">
        <sl-icon slot="prefix" name="plus-circle"></sl-icon>
        Novo Evento
    </sl-button>
</div>

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <sl-alert variant="{{ label == 'success' ? 'success' : 'danger' }}" open class="mb-4">
            <sl-icon slot="icon" name="{{ label == 'success' ? 'check-circle' : 'exclamation-triangle' }}"></sl-icon>
            {{ message }}
        </sl-alert>
    {% endfor %}
{% endfor %}

<sl-card class="w-full">
    <div class="overflow-x-auto">
        <table id="crud-table" class="w-full text-sm text-left border-collapse border border-slate-200 dark:border-white/10">
            <thead>
                <tr>
                    <th>Logo</th>
                    <th>Nome</th>
                    <th>Chave Pix</th>
                    <th>Datas</th>
                    <th>Status</th>
                    <th>Token</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                {% for evento in eventos %}
                <tr>
                    <td>
                        {% if evento.logoName %}
                            <img src="{{ vich_uploader_asset(evento, 'logoFile') }}" class="h-10 w-auto object-contain rounded" alt="{{ evento.nome }}">
                        {% else %}
                            <sl-icon name="calendar-event" class="text-2xl text-slate-400"></sl-icon>
                        {% endif %}
                    </td>
                    <td class="font-medium">{{ evento.nome }}</td>
                    <td class="font-mono text-xs">{{ evento.chavePix }}</td>
                    <td class="text-xs">
                        {% if evento.dataInicio %}{{ evento.dataInicio|date('d/m/Y') }}{% endif %}
                        {% if evento.dataFim %} – {{ evento.dataFim|date('d/m/Y') }}{% endif %}
                    </td>
                    <td>
                        <sl-badge variant="{{ evento.status == 'ativo' ? 'success' : 'neutral' }}">
                            {{ evento.status }}
                        </sl-badge>
                    </td>
                    <td>
                        <div class="flex items-center gap-1">
                            <span class="font-mono text-xs text-slate-500 truncate max-w-[120px]">{{ evento.token }}</span>
                            <a href="{{ path('app_pub_evento_show', {token: evento.token}) }}" target="_blank" class="text-blue-500 hover:text-blue-700" title="Ver página pública">
                                <sl-icon name="box-arrow-up-right"></sl-icon>
                            </a>
                        </div>
                    </td>
                    <td>
                        <div class="flex gap-2">
                            <sl-button href="{{ path('app_admin_evento_edit', {id: evento.id}) }}" size="small" variant="neutral">
                                <sl-icon name="pencil"></sl-icon>
                            </sl-button>
                            <form action="{{ path('app_admin_evento_delete', {id: evento.id}) }}" method="post" onsubmit="return confirm('Confirma exclusão?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evento.id) }}">
                                <sl-button type="submit" size="small" variant="danger">
                                    <sl-icon name="trash"></sl-icon>
                                </sl-button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</sl-card>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function initDataTable() {
            const table = document.getElementById('crud-table');
            if (table && !$.fn.DataTable.isDataTable(table)) {
                new DataTable('#crud-table', {
                    language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/pt-BR.json' },
                    responsive: true,
                    pageLength: 100,
                    lengthMenu: [[100, 1000, -1], ['100', '1000', 'Todos']],
                });
            }
        }
        $(document).ready(initDataTable);
        document.addEventListener('turbo:load', initDataTable);
    </script>
{% endblock %}

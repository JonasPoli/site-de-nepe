{% extends 'admin/base.html.twig' %}

{% block title %}{{ evento is defined ? 'Editar Evento' : 'Novo Evento' }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .form-section-title { font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: #94a3b8; margin-bottom: .5rem; margin-top: 1.25rem; }
        
        .preview-window {
            background: #f1f5f9;
            box-shadow: inset 0 2px 10px rgba(0,0,0,0.05);
        }
        
        #preview-container {
            box-shadow: 0 50px 100px -20px rgba(50, 50, 93, 0.25), 0 30px 60px -30px rgba(0, 0, 0, 0.3);
            border-radius: 20px;
            overflow-y: auto;
            overflow-x: hidden;
        }

        #preview-container::-webkit-scrollbar { width: 8px; }
        #preview-container::-webkit-scrollbar-track { background: transparent; }
        #preview-container::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.1); border-radius: 10px; }
        
        #simulated-page {
            transition: background-color 0.3s ease;
        }

        /* Prevent Shoelace components from being too small in scaled preview */
        #simulated-page sl-icon {
            font-size: 140px;
        }
    </style>
{% endblock %}

{% block body %}
<div class="flex items-center justify-between mb-6">
    <div>
        <a href="{{ path('app_admin_evento_index') }}" class="text-slate-500 hover:text-slate-700 text-sm flex items-center gap-1 mb-1">
            <sl-icon name="arrow-left"></sl-icon> Voltar
        </a>
        <h1 class="text-2xl font-bold">{{ evento is defined ? 'Editar Evento' : 'Novo Evento' }}</h1>
    </div>
</div>

{{ form_start(form, {attr: {enctype: 'multipart/form-data', class: 'space-y-4'}}) }}

<div class="grid grid-cols-1 xl:grid-cols-[1fr_450px] gap-8 items-start">
    <sl-card class="w-full">
        <p class="form-section-title">Dados Gerais</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="md:col-span-2">{{ form_row(form.nome) }}</div>
            <div class="md:col-span-2">{{ form_row(form.descricao) }}</div>
            {{ form_row(form.status) }}
            {{ form_row(form.dataInicio) }}
            {{ form_row(form.dataFim) }}
            <div class="md:col-span-2">{{ form_row(form.mensagemSucesso) }}</div>
        </div>

        <p class="form-section-title">Pagamento Pix</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {{ form_row(form.chavePix) }}
            {{ form_row(form.beneficiarioPix) }}
            {{ form_row(form.cidadePix) }}
        </div>

        <p class="form-section-title">Mídias</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {{ form_row(form.bannerFile) }}
            {{ form_row(form.logoFile) }}
        </div>

        <p class="form-section-title">Identidade Visual</p>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
            {% for field in [form.corBackground, form.corTexto, form.corTextoSecundario, form.corBotaoPrimario, form.corBotaoSecundario] %}
                <div class="flex flex-col gap-2 p-3 rounded-xl border border-slate-200 dark:border-slate-800 bg-white/50 dark:bg-slate-900/50">
                    <label class="text-[0.65rem] uppercase font-bold text-slate-400 tracking-wider">
                        {{ field.vars.label }}
                    </label>
                    {{ form_widget(field, {attr: {class: 'hidden'}}) }}
                    <sl-color-picker 
                        hoist
                        opacity
                        value="{{ field.vars.value ?: (field.vars.name == 'corBackground' ? '#ffffff' : '#000000') }}" 
                        data-sync="#{{ field.vars.id }}"
                    ></sl-color-picker>
                    <div class="text-[0.7rem] font-mono text-slate-400 mt-1 uppercase" id="hex-{{ field.vars.id }}">
                        {{ field.vars.value ?: (field.vars.name == 'corBackground' ? '#ffffff' : '#000000') }}
                    </div>
                </div>
            {% endfor %}
        </div>

        <div class="flex justify-between mt-8 pt-6 border-t border-slate-100 dark:border-slate-800">
            <sl-button href="{{ path('app_admin_evento_index') }}" variant="neutral">Cancelar</sl-button>
            <sl-button type="submit" variant="primary">
                <sl-icon slot="prefix" name="check-circle"></sl-icon>
                Salvar Evento
            </sl-button>
        </div>
    </sl-card>

    {# Live Preview Panel #}
    <div class="sticky top-10 space-y-4">
        <div class="flex items-center justify-between mb-2">
            <h3 class="text-sm font-bold uppercase tracking-widest text-slate-400">Live Preview (50%)</h3>
            <sl-button-group size="small">
                <sl-button variant="default" onclick="switchPreview('show')" id="btn-preview-show" pill>Inscrição</sl-button>
                <sl-button variant="default" onclick="switchPreview('finalizado')" id="btn-preview-finalizado" pill>Sucesso</sl-button>
            </sl-button-group>
        </div>

        <div class="preview-window rounded-2xl overflow-hidden border border-slate-200 shadow-2xl bg-slate-100 relative" style="height: 600px; width: 100%;">
            <div id="preview-container" class="transition-all duration-300 origin-top" style="transform: scale(0.5); width: 800px; height: 1200px; position: absolute; left: -175px; top: 0;">
                <div id="simulated-page" class="bg-[var(--cor-bg)] min-h-screen font-sans">
                    {# Content will be injected by JS from templates below #}
                </div>
            </div>
        </div>
        <p class="text-[0.65rem] text-slate-400 text-center italic">Visualização real processada via Twig (50% zoom).</p>
    </div>
</div>

{# Hidden Templates area: rendered with real Twig #}
<div id="twig-templates" class="hidden">
    <div id="tmpl-show">
        {{ include('pub/evento/_show_content.html.twig', {is_preview: true}) }}
    </div>
    <div id="tmpl-finalizado">
        {{ include('pub/evento/_finalizar_content.html.twig', {is_preview: true}) }}
    </div>
</div>

{{ form_end(form) }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.tiny.cloud/1/{{ tinymce_key }}/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
    <script>
        tinymce.init({
            selector: '.tinymce',
            language: 'pt_BR',
            plugins: 'lists link image code',
            toolbar: 'undo redo | bold italic | alignleft aligncenter alignright | bullist numlist | link image | code',
            height: 300,
            setup: function (editor) {
                editor.on('Change KeyUp', function (e) {
                    updatePreviewContent();
                });
            }
        });

        const form = {
            nome: document.querySelector('#{{ form.nome.vars.id }}'),
            bg: document.querySelector('#{{ form.corBackground.vars.id }}'),
            txt: document.querySelector('#{{ form.corTexto.vars.id }}'),
            sec: document.querySelector('#{{ form.corTextoSecundario.vars.id }}'),
            btnP: document.querySelector('#{{ form.corBotaoPrimario.vars.id }}'),
            btnS: document.querySelector('#{{ form.corBotaoSecundario.vars.id }}'),
            banner: document.querySelector('#{{ form.bannerFile.file.vars.id }}'),
            logo: document.querySelector('#{{ form.logoFile.file.vars.id }}')
        };

        let currentPreviewMode = 'show';

        function updatePreviewStyles() {
            const container = document.getElementById('simulated-page');
            container.style.backgroundColor = form.bg.value;
            container.style.setProperty('--cor-bg', form.bg.value);
            container.style.setProperty('--cor-texto', form.txt.value);
            container.style.setProperty('--cor-texto-sec', form.sec.value);
            container.style.setProperty('--cor-btn-primary', form.btnP.value);
            container.style.setProperty('--cor-btn-secondary', form.btnS.value);
        }

        function updatePreviewContent() {
            const container = document.getElementById('simulated-page');
            const source = document.getElementById(currentPreviewMode === 'show' ? 'tmpl-show' : 'tmpl-finalizado');
            
            // Clone the template content
            container.innerHTML = source.innerHTML;

            // Sync dynamic texts
            const nameNodes = container.querySelectorAll('#p-name, #p-name-final');
            nameNodes.forEach(n => n.textContent = form.nome.value || 'Nome do Evento');

            const descNodes = container.querySelectorAll('#p-desc');
            const desc = tinymce.get('{{ form.descricao.vars.id }}')?.getContent() || 'Descrição do evento aqui...';
            descNodes.forEach(n => n.innerHTML = desc);

            // Sync images
            const banner = container.querySelector('#p-banner');
            const bannerSrc = document.getElementById('p-banner-src')?.src;
            if (banner && bannerSrc) {
                banner.src = bannerSrc;
                banner.style.display = 'block';
            }

            const logoNodes = container.querySelectorAll('#p-logo, #p-logo-final');
            const logoSrc = document.getElementById('p-logo-src')?.src;
            logoNodes.forEach(l => {
                if (logoSrc) {
                    l.src = logoSrc;
                    l.style.display = 'block';
                }
            });

            updatePreviewStyles();
        }

        function switchPreview(mode) {
            currentPreviewMode = mode;
            document.getElementById('btn-preview-show').variant = mode === 'show' ? 'primary' : 'default';
            document.getElementById('btn-preview-finalizado').variant = mode === 'finalizado' ? 'primary' : 'default';
            updatePreviewContent();
        }

        // Image Preview Logic
        function handleImagePreview(input, targetId) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    let img = document.getElementById(targetId);
                    if (!img) {
                        img = document.createElement('img');
                        img.id = targetId;
                        img.className = 'hidden';
                        document.body.appendChild(img);
                    }
                    img.src = e.target.result;
                    updatePreviewContent();
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        // Setup Listeners
        window.addEventListener('DOMContentLoaded', () => {
            // Initial images from server (if they exist)
            {% if evento is defined %}
                {% if evento.bannerName %}
                    const bImg = document.createElement('img');
                    bImg.id = 'p-banner-src';
                    bImg.src = '{{ vich_uploader_asset(evento, 'bannerFile') }}';
                    bImg.className = 'hidden';
                    document.body.appendChild(bImg);
                {% endif %}
                {% if evento.logoName %}
                    const lImg = document.createElement('img');
                    lImg.id = 'p-logo-src';
                    lImg.src = '{{ vich_uploader_asset(evento, 'logoFile') }}';
                    lImg.className = 'hidden';
                    document.body.appendChild(lImg);
                {% endif %}
            {% endif %}

            switchPreview('show');

            form.nome.addEventListener('input', updatePreviewContent);
            form.banner.addEventListener('change', (e) => handleImagePreview(e.target, 'p-banner-src'));
            form.logo.addEventListener('change', (e) => handleImagePreview(e.target, 'p-logo-src'));

            document.querySelectorAll('sl-color-picker[data-sync]').forEach(picker => {
                picker.addEventListener('sl-change', () => {
                    const target = document.querySelector(picker.dataset.sync);
                    if (target) {
                        target.value = picker.value;
                        document.getElementById('hex-' + target.id).textContent = picker.value;
                        updatePreviewStyles();
                    }
                });
            });
        });
    </script>
{% endblock %}

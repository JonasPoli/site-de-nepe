<form method="post" action="{{ action }}" class="af">
    <input type="hidden" name="type" value="newsletter">
    <div class="af-field">
        <label>Título principal</label>
        <input type="text" name="title" class="ai" value="{{ block.title }}" placeholder="Assine nossa newsletter">
    </div>
    <div class="af-field">
        <label>Subtítulo / Descrição</label>
        <textarea name="text" class="ate" rows="3">{{ block.text }}</textarea>
    </div>
    <div class="af-field">
        <label>Texto do botão</label>
        <input type="text" name="config[buttonText]" class="ai" value="{{ block.config.buttonText ?? 'Quero receber' }}">
    </div>
    <div class="af-field">
        <label>Texto de confirmação (após cadastro)</label>
        <input type="text" name="config[successText]" class="ai" value="{{ block.config.successText ?? 'Obrigado! Você foi cadastrado com sucesso.' }}">
    </div>
    <fieldset style="border:1px solid var(--border);border-radius:10px;padding:1.25rem;margin-top:1rem">
        <legend style="font-size:.85rem;font-weight:700;padding:0 .5rem">Blorbs / Destaques (opcional)</legend>
        {% for i in 0..2 %}
        <div class="af-row" style="margin-bottom:.5rem">
            <div class="af-field">
                <label>Ícone {{ i+1 }} (Font Awesome class)</label>
                <input type="text" name="config[blorbs][{{ i }}][icon]" class="ai" value="{{ block.config.blorbs[i].icon ?? '' }}" placeholder="fa-solid fa-check">
            </div>
            <div class="af-field">
                <label>Texto {{ i+1 }}</label>
                <input type="text" name="config[blorbs][{{ i }}][text]" class="ai" value="{{ block.config.blorbs[i].text ?? '' }}">
            </div>
        </div>
        {% endfor %}
    </fieldset>
    <div class="af-actions">
        <button type="submit" class="btn btn-p"><sl-icon name="check-lg"></sl-icon> Salvar</button>
        <a href="{{ path('admin_block_index', {sectionId: block.section.id ?? section.id}) }}" class="btn btn-g">Cancelar</a>
    </div>
</form>

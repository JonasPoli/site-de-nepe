{# _macros.html.twig — helpers comuns aos formulários de bloco #}
{% macro prevImg(inputId, targetId) %}
<script>
function prevImg_{{ inputId }}(input) {
    if (!input.files || !input.files[0]) return;
    const r = new FileReader();
    r.onload = e => {
        let el = document.getElementById('{{ targetId }}');
        if (el && el.tagName === 'DIV') {
            const img = document.createElement('img');
            img.id = '{{ targetId }}';
            img.style.cssText = 'height:80px;border-radius:8px;object-fit:cover;border:1px solid var(--border)';
            el.replaceWith(img); el = img;
        }
        if (el) el.src = e.target.result;
    };
    r.readAsDataURL(input.files[0]);
}
</script>
{% endmacro %}

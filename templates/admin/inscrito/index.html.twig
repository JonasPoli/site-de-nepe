{% extends 'admin/base.html.twig' %}

{% block title %}Inscritos{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.datatables.net/2.1.3/css/dataTables.tailwindcss.min.css">
{% endblock %}

{% block body %}
<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">Inscritos</h1>
    <sl-button href="{{ path('app_admin_inscrito_export_csv') }}" variant="success">
        <sl-icon slot="prefix" name="file-earmark-spreadsheet"></sl-icon>
        Exportar CSV
    </sl-button>
</div>

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <sl-alert variant="{{ label == 'success' ? 'success' : 'danger' }}" open class="mb-4">
            <sl-icon slot="icon" name="{{ label == 'success' ? 'check-circle' : 'exclamation-triangle' }}"></sl-icon>
            {{ message }}
        </sl-alert>
    {% endfor %}
{% endfor %}

<sl-card class="w-full">
    <div class="overflow-x-auto">
        <table id="crud-table" class="w-full text-sm text-left border-collapse border border-slate-200 dark:border-white/10">
            <thead>
                <tr>
                    <th>Evento</th>
                    <th>Nome Completo</th>
                    <th>Tipo Inscrição</th>
                    <th>Itens Adicionais</th>
                    <th>Valor Total</th>
                    <th>Data</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                {% for inscrito in inscritos %}
                <tr>
                    <td>
                        <div class="flex items-center gap-2">
                            {% if inscrito.inscricao.evento.logoName %}
                                <img src="{{ vich_uploader_asset(inscrito.inscricao.evento, 'logoFile') }}" class="h-8 w-auto object-contain rounded" alt="">
                            {% endif %}
                            <span class="text-xs">{{ inscrito.inscricao.evento.nome }}</span>
                        </div>
                    </td>
                    <td>
                        <div class="font-medium">{{ inscrito.nomeCompleto }}</div>
                        <div class="text-xs text-slate-500">{{ inscrito.email }}</div>
                    </td>
                    <td>
                        <div class="font-medium">{{ inscrito.tipoInscricao.nome }}</div>
                        <div class="text-xs text-slate-500">R$ {{ inscrito.tipoInscricao.valorBase|number_format(2, ',', '.') }}</div>
                    </td>
                    <td>
                        {% for item in inscrito.itensAdicionais %}
                            <div class="text-xs">{{ item.descricao }} <span class="text-slate-500">R$ {{ item.valor|number_format(2, ',', '.') }}</span></div>
                        {% else %}
                            <span class="text-slate-400 text-xs">Nenhum</span>
                        {% endfor %}
                    </td>
                    <td class="font-bold">R$ {{ inscrito.valorTotal|number_format(2, ',', '.') }}</td>
                    <td class="text-xs">{{ inscrito.createdAt|date('d/m/Y H:i') }}</td>
                    <td>
                        <sl-badge variant="{{ inscrito.status == 'ativo' ? 'success' : 'neutral' }}">{{ inscrito.status }}</sl-badge>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</sl-card>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function initDataTable() {
            const table = document.getElementById('crud-table');
            if (table && !$.fn.DataTable.isDataTable(table)) {
                new DataTable('#crud-table', {
                    language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/pt-BR.json' },
                    responsive: true,
                    pageLength: 100,
                    lengthMenu: [[100, 1000, -1], ['100', '1000', 'Todos']],
                });
            }
        }
        $(document).ready(initDataTable);
        document.addEventListener('turbo:load', initDataTable);
    </script>
{% endblock %}

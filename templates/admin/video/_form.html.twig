{# Reusable video form macro #}
{% macro video_form(video, categories, action, _unused) %}
<form action="{{ action }}" method="post" class="af" enctype="multipart/form-data">
    <div class="af-row">
        <div class="af-field">
            <label>Título <span class="req">*</span></label>
            <input type="text" name="title" class="ai" value="{{ video.title }}" required>
        </div>
        <div class="af-field">
            <label>YouTube ID <span class="req">*</span></label>
            <input type="text" name="youtubeId" id="video_youtube_id" class="ai" value="{{ video.youtubeId }}" required placeholder="dQw4w9WgXcQ"
                   oninput="onYoutubeIdChange(this.value)">
            <p class="af-hint">Ex: dQw4w9WgXcQ (código após <code>v=</code> na URL do YouTube)</p>
        </div>
    </div>

    {# ── Miniatura (Thumbnail) ── #}
    <div class="af-field">
        <label>Miniatura (Thumbnail)</label>
        
        <div style="display:flex;flex-wrap:wrap;gap:1.5rem;align-items:flex-start;margin-bottom:1rem">
            {# Preview #}
            <div style="width:100%;max-width:360px">
                <div id="thumb-preview-box" style="width:100%;aspect-ratio:16/9;border-radius:10px;overflow:hidden;background:var(--bg3);border:1px solid var(--border);position:relative;display:flex;align-items:center;justify-content:center">
                    <img id="thumb-preview" src="{{ video.thumbnailUrl }}" alt="Preview da miniatura"
                         style="width:100%;height:100%;object-fit:cover;{{ video.thumbnailUrl ? '' : 'display:none;' }}">
                    <div id="thumb-placeholder" style="color:var(--muted);font-size:.85rem;text-align:center;padding:1rem;{{ video.thumbnailUrl ? 'display:none;' : '' }}">
                        <sl-icon name="image" style="font-size:2rem;display:block;margin:0 auto .5rem;opacity:.5"></sl-icon>
                        Nenhuma miniatura disponível
                    </div>
                    <div id="thumb-source-badge" style="position:absolute;bottom:8px;left:8px;background:rgba(0,0,0,.75);color:#fff;font-size:.72rem;padding:.2rem .55rem;border-radius:6px;backdrop-filter:blur(4px);display:flex;align-items:center;gap:.35rem">
                        {% if video.hasCustomThumbnail %}
                            <sl-icon name="image"></sl-icon> Personalizada
                        {% elseif video.youtubeId %}
                            <sl-icon name="youtube"></sl-icon> Padrão do YouTube
                        {% else %}
                            <sl-icon name="dash"></sl-icon> Indefinida
                        {% endif %}
                    </div>
                </div>
            </div>

            {# Controls #}
            <div style="flex:1;min-width:280px;display:flex;flex-direction:column;gap:.75rem">
                <div>
                    <label style="font-size:.85rem;font-weight:600;display:block;margin-bottom:.35rem">Subir miniatura personalizada</label>
                    <input type="file" name="customThumbnailFile" id="customThumbnailFileInput" accept="image/*" onchange="previewCustomThumb(this)"
                           style="font-size:.85rem;padding:.4rem 0">
                    <p class="af-hint">Formatos: JPG, PNG, WEBP. Proporção recomendada: 16:9 (ex: 1280x720).</p>
                </div>

                {% if video.hasCustomThumbnail %}
                <div style="padding:.75rem;background:var(--bg2);border-radius:8px;border:1px solid var(--border)">
                    <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer;font-size:.85rem;color:#ef4444;font-weight:500">
                        <input type="checkbox" name="remove_custom_thumbnail" value="1" id="removeCustomThumbCheckbox"
                               onchange="onToggleRemoveCustomThumb(this)" style="accent-color:#ef4444">
                        Remover miniatura personalizada e usar padrão do YouTube
                    </label>
                </div>
                {% endif %}
                
                <p class="af-hint" style="margin:0">
                    💡 Se nenhuma imagem personalizada for enviada, a miniatura oficial em alta resolução do YouTube será utilizada automaticamente.
                </p>
            </div>
        </div>
    </div>

    <div class="af-row">
        <div class="af-field">
            <label>Slug</label>
            <input type="text" name="slug" class="ai" value="{{ video.slug }}" placeholder="gerado automaticamente">
        </div>
        <div class="af-field">
            <label>Categoria</label>
            <select name="category" class="as">
                <option value="">— Sem categoria —</option>
                {% for cat in categories %}
                    <option value="{{ cat.id }}" {{ video.category and video.category.id == cat.id ? 'selected' }}>{{ cat.name }}</option>
                {% endfor %}
            </select>
        </div>
    </div>
    <div class="af-field">
        <label>Descrição</label>
        <textarea name="description" class="ate" rows="4">{{ video.description }}</textarea>
    </div>

    {# ── Materiais e Referências ── #}
    <div class="af-field">
        <label>Materiais e Referências</label>
        {{ include('admin/_rich_editor.html.twig', {
            field_id: 'materials-editor',
            field_name: 'materialsHtml',
            content: video.materialsHtml,
            height: 400
        }) }}
        <p class="af-hint">Editor de texto rico — adicione links, tabelas, listas e formatação.</p>
    </div>

    {# ── Upload de arquivos ── #}
    <div class="af-field">
        <label>Arquivos para download</label>

        {# Materiais existentes #}
        {% if video.materials|length > 0 %}
        <div id="existing-materials" style="margin-bottom:1.25rem">
            <div style="font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:.75rem">Arquivos atuais</div>
            {% for mat in video.materials %}
            <div class="mat-row" style="display:flex;align-items:center;gap:.75rem;padding:.65rem .9rem;background:var(--bg2);border-radius:8px;margin-bottom:.5rem;border:1px solid var(--border)">
                <span class="mat-icon" style="font-size:1.3rem">{{ mat.extension in ['pdf'] ? '📄' : (mat.extension in ['xls','xlsx'] ? '📊' : (mat.extension in ['doc','docx'] ? '📝' : (mat.extension in ['png','jpg','jpeg'] ? '🖼️' : '📎'))) }}</span>
                <span style="flex:1;font-size:.9rem;font-weight:500">{{ mat.label }}</span>
                <span style="font-size:.75rem;color:var(--muted)">{{ mat.extension|upper }}</span>
                <label style="display:flex;align-items:center;gap:.4rem;cursor:pointer;font-size:.8rem;color:#ef4444">
                    <input type="checkbox" name="delete_material[]" value="{{ mat.id }}"
                           style="accent-color:#ef4444"> Remover
                </label>
            </div>
            {% endfor %}
        </div>
        {% endif %}

        {# Adicionar novos arquivos #}
        <div id="new-materials">
            <div style="font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:.75rem">Adicionar arquivos</div>
            <div id="mat-list"></div>
            <button type="button" onclick="addMaterialRow()" class="btn btn-g" style="margin-top:.5rem">
                <sl-icon name="plus-lg"></sl-icon> Adicionar arquivo
            </button>
            <p class="af-hint" style="margin-top:.5rem">Formatos aceitos: PDF, XLS, XLSX, DOC, DOCX, TXT, CSV, PNG, JPG</p>
        </div>
    </div>

    <div class="af-actions">
        <button type="submit" class="btn btn-p"><sl-icon name="check-lg"></sl-icon> Salvar</button>
        <a href="{{ path('admin_video_index') }}" class="btn btn-g">Cancelar</a>
    </div>
</form>

<script>
// Thumbnail logic
const initialCustomThumbUrl = '{{ video.hasCustomThumbnail ? video.thumbnailUrl : '' }}';
const initialYoutubeId = '{{ video.youtubeId }}';
let isCustomFileSelected = false;

function getYoutubeThumbUrl(id) {
    if (!id || id.trim() === '') return '';
    return 'https://img.youtube.com/vi/' + id.trim() + '/maxresdefault.jpg';
}

function updateBadge(type) {
    const badge = document.getElementById('thumb-source-badge');
    if (!badge) return;
    if (type === 'custom') {
        badge.innerHTML = '<sl-icon name="image"></sl-icon> Personalizada (novo upload)';
        badge.style.display = 'flex';
    } else if (type === 'custom-saved') {
        badge.innerHTML = '<sl-icon name="image"></sl-icon> Personalizada';
        badge.style.display = 'flex';
    } else if (type === 'youtube') {
        badge.innerHTML = '<sl-icon name="youtube"></sl-icon> Padrão do YouTube';
        badge.style.display = 'flex';
    } else {
        badge.style.display = 'none';
    }
}

function updatePreviewDisplay(url, type) {
    const img = document.getElementById('thumb-preview');
    const placeholder = document.getElementById('thumb-placeholder');
    if (url) {
        img.src = url;
        img.style.display = 'block';
        if (placeholder) placeholder.style.display = 'none';
        updateBadge(type);
    } else {
        img.src = '';
        img.style.display = 'none';
        if (placeholder) placeholder.style.display = 'block';
        updateBadge('none');
    }
}

function previewCustomThumb(input) {
    const removeCb = document.getElementById('removeCustomThumbCheckbox');
    if (removeCb) removeCb.checked = false;

    if (input.files && input.files[0]) {
        isCustomFileSelected = true;
        const reader = new FileReader();
        reader.onload = e => {
            updatePreviewDisplay(e.target.result, 'custom');
        };
        reader.readAsDataURL(input.files[0]);
    } else {
        isCustomFileSelected = false;
        refreshPreview();
    }
}

function onToggleRemoveCustomThumb(cb) {
    if (cb.checked) {
        const fileInput = document.getElementById('customThumbnailFileInput');
        if (fileInput) fileInput.value = '';
        isCustomFileSelected = false;
        const ytId = document.getElementById('video_youtube_id')?.value || initialYoutubeId;
        const ytUrl = getYoutubeThumbUrl(ytId);
        updatePreviewDisplay(ytUrl, ytUrl ? 'youtube' : 'none');
    } else {
        refreshPreview();
    }
}

function onYoutubeIdChange(ytId) {
    const removeCb = document.getElementById('removeCustomThumbCheckbox');
    const isRemoveChecked = removeCb ? removeCb.checked : false;

    if (!isCustomFileSelected && (!initialCustomThumbUrl || isRemoveChecked)) {
        const ytUrl = getYoutubeThumbUrl(ytId);
        updatePreviewDisplay(ytUrl, ytUrl ? 'youtube' : 'none');
    }
}

function refreshPreview() {
    const removeCb = document.getElementById('removeCustomThumbCheckbox');
    const isRemoveChecked = removeCb ? removeCb.checked : false;

    if (isCustomFileSelected) {
        return;
    }

    if (initialCustomThumbUrl && !isRemoveChecked) {
        updatePreviewDisplay(initialCustomThumbUrl, 'custom-saved');
    } else {
        const ytId = document.getElementById('video_youtube_id')?.value || initialYoutubeId;
        const ytUrl = getYoutubeThumbUrl(ytId);
        updatePreviewDisplay(ytUrl, ytUrl ? 'youtube' : 'none');
    }
}

// Dynamic material file rows
let matIdx = 0;
function addMaterialRow(){
    const list = document.getElementById('mat-list');
    const idx  = matIdx++;
    const row  = document.createElement('div');
    row.className = 'mat-new-row';
    row.style.cssText = 'display:grid;grid-template-columns:1fr 1fr auto;gap:.75rem;margin-bottom:.75rem;align-items:center';
    row.innerHTML = `
        <div>
            <label style="font-size:.75rem;font-weight:600;color:var(--muted);display:block;margin-bottom:.25rem">Nome do arquivo <span style="color:#ef4444">*</span></label>
            <input type="text" name="material_label[${idx}]" class="ai" placeholder="Ex: Slides da Aula 1" style="width:100%">
        </div>
        <div>
            <label style="font-size:.75rem;font-weight:600;color:var(--muted);display:block;margin-bottom:.25rem">Arquivo <span style="color:#ef4444">*</span></label>
            <input type="file" name="material_file[${idx}]"
                   accept=".pdf,.xls,.xlsx,.doc,.docx,.txt,.csv,.png,.jpg,.jpeg"
                   style="font-size:.85rem;padding:.4rem 0">
        </div>
        <button type="button" onclick="this.closest('.mat-new-row').remove()"
                style="background:rgba(239,68,68,.1);color:#ef4444;border:none;border-radius:8px;padding:.5rem .75rem;cursor:pointer;margin-top:1.3rem">✕</button>
    `;
    list.appendChild(row);
}
</script>
{% endmacro %}


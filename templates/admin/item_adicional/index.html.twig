{% extends 'admin/base.html.twig' %}

{% block title %}Itens Adicionais{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.datatables.net/2.1.3/css/dataTables.tailwindcss.min.css">
{% endblock %}

{% block body %}
<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">Itens Adicionais</h1>
    <sl-button href="{{ path('app_admin_item_adicional_new') }}" variant="primary">
        <sl-icon slot="prefix" name="plus-circle"></sl-icon>
        Novo Item
    </sl-button>
</div>

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <sl-alert variant="{{ label == 'success' ? 'success' : 'danger' }}" open class="mb-4">
            <sl-icon slot="icon" name="{{ label == 'success' ? 'check-circle' : 'exclamation-triangle' }}"></sl-icon>
            {{ message }}
        </sl-alert>
    {% endfor %}
{% endfor %}

<sl-card class="w-full">
    <div class="overflow-x-auto">
        <table id="crud-table" class="w-full text-sm text-left border-collapse border border-slate-200 dark:border-white/10">
            <thead>
                <tr>
                    <th>Evento</th>
                    <th>Tipo de Inscrição</th>
                    <th>Descrição</th>
                    <th>Valor</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                {% for item in itens %}
                <tr>
                    <td>
                        <div class="flex items-center gap-2">
                            {% if item.tipoInscricao.evento.logoName %}
                                <img src="{{ vich_uploader_asset(item.tipoInscricao.evento, 'logoFile') }}" class="h-8 w-auto object-contain rounded" alt="">
                            {% endif %}
                            <span>{{ item.tipoInscricao.evento.nome }}</span>
                        </div>
                    </td>
                    <td>{{ item.tipoInscricao.nome }}</td>
                    <td class="font-medium">{{ item.descricao }}</td>
                    <td class="font-semibold">R$ {{ item.valor|number_format(2, ',', '.') }}</td>
                    <td>
                        <sl-badge variant="{{ item.status == 'ativo' ? 'success' : 'neutral' }}">{{ item.status }}</sl-badge>
                    </td>
                    <td>
                        <div class="flex gap-2">
                            <sl-button href="{{ path('app_admin_item_adicional_edit', {id: item.id}) }}" size="small" variant="neutral">
                                <sl-icon name="pencil"></sl-icon>
                            </sl-button>
                            <form action="{{ path('app_admin_item_adicional_delete', {id: item.id}) }}" method="post" onsubmit="return confirm('Confirma exclusão?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ item.id) }}">
                                <sl-button type="submit" size="small" variant="danger">
                                    <sl-icon name="trash"></sl-icon>
                                </sl-button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</sl-card>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function initDataTable() {
            const table = document.getElementById('crud-table');
            if (table && !$.fn.DataTable.isDataTable(table)) {
                new DataTable('#crud-table', {
                    language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/pt-BR.json' },
                    responsive: true,
                    pageLength: 100,
                    lengthMenu: [[100, 1000, -1], ['100', '1000', 'Todos']],
                });
            }
        }
        $(document).ready(initDataTable);
        document.addEventListener('turbo:load', initDataTable);
    </script>
{% endblock %}

{% extends 'admin/nepe_base.html.twig' %}
{% block title %}Nova Categoria{% endblock %}{% block page_title %}Nova Categoria{% endblock %}
{% block body %}
<div class="ph"><h1>Nova Categoria</h1><a href="{{ path('admin_category_index') }}" class="btn btn-g"><sl-icon name="arrow-left"></sl-icon> Voltar</a></div>
<div class="card"><form action="{{ path('admin_category_new') }}" method="post" class="af">
    <div class="af-field"><label>Nome <span class="req">*</span></label><input type="text" name="name" class="ai" required autofocus></div>
    <div class="af-actions"><button type="submit" class="btn btn-p"><sl-icon name="check-lg"></sl-icon> Salvar</button><a href="{{ path('admin_category_index') }}" class="btn btn-g">Cancelar</a></div>
</form></div>
{% endblock %}

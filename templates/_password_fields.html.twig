{#
  Dois campos de senha com botão de olho, lista de requisitos e conferência ao digitar.

  Usada no painel (/admin, layout com Shoelace) e nas telas de login/redefinição (layout sem
  Shoelace): por isso o CSS e o JS são próprios e não dependem de nada da página.

  Parâmetros (todos opcionais):
    name            nome do campo da senha           (padrão: password)
    confirm_name    nome do campo de repetição       (padrão: password_confirmation)
    label           rótulo do primeiro campo         (padrão: Nova senha)
    confirm_label   rótulo do segundo campo          (padrão: Repita a nova senha)
    hint            texto de apoio abaixo do rótulo  (padrão: nenhum)
    required        true  = senha obrigatória nesta tela (criação de usuário)
                    false = os dois campos em branco mantêm a senha atual
    input_class     classe dos <input> do layout da página (padrão: ai, do /admin)
    field_class     classe extra da div de cada campo (ex.: field, nas telas de login)
    stack           true empilha os campos e a lista numa coluna só (cartões estreitos, como o login)
#}
{% set pw_name = name|default('password') %}
{% set pw_confirm_name = confirm_name|default('password_confirmation') %}
{% set pw_label = label|default('Nova senha') %}
{% set pw_confirm_label = confirm_label|default('Repita a nova senha') %}
{% set pw_required = required|default(false) %}
{% set pw_input_class = input_class|default('ai') %}
{% set pw_field_class = field_class|default('') %}
{% set pw_stack = stack|default(false) %}
{% set pw_uid = 'pw' ~ random(100000, 999999) %}

<div class="pw-fields {{ pw_stack ? 'pw-stacked' : '' }}" id="{{ pw_uid }}" data-required="{{ pw_required ? '1' : '0' }}" data-min-length="{{ password_min_length() }}">
    <div class="pw-row">
        <div class="pw-field {{ pw_field_class }}">
            <label for="{{ pw_uid }}-a">{{ pw_label }}{% if pw_required %} <span class="req">*</span>{% endif %}</label>
            <div class="pw-input">
                <input type="password" id="{{ pw_uid }}-a" name="{{ pw_name }}" class="{{ pw_input_class }}"
                       autocomplete="new-password" {% if pw_required %}required{% endif %}
                       placeholder="••••••••" data-pw="main">
                <button type="button" class="pw-eye" data-pw-toggle="{{ pw_uid }}-a"
                        aria-label="Ver a senha" title="Ver a senha" aria-pressed="false">
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" data-pw-icon="open">
                        <path fill="none" stroke="currentColor" stroke-width="1.7" d="M1.8 12S5.5 5.5 12 5.5 22.2 12 22.2 12 18.5 18.5 12 18.5 1.8 12 1.8 12Z"/>
                        <circle cx="12" cy="12" r="3.2" fill="none" stroke="currentColor" stroke-width="1.7"/>
                    </svg>
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" data-pw-icon="closed" style="display:none">
                        <path fill="none" stroke="currentColor" stroke-width="1.7" d="M1.8 12S5.5 5.5 12 5.5 22.2 12 22.2 12 18.5 18.5 12 18.5 1.8 12 1.8 12Z"/>
                        <circle cx="12" cy="12" r="3.2" fill="none" stroke="currentColor" stroke-width="1.7"/>
                        <path stroke="currentColor" stroke-width="1.7" d="M4 20 20 4"/>
                    </svg>
                </button>
            </div>
        </div>
        <div class="pw-field {{ pw_field_class }}">
            <label for="{{ pw_uid }}-b">{{ pw_confirm_label }}{% if pw_required %} <span class="req">*</span>{% endif %}</label>
            <div class="pw-input">
                <input type="password" id="{{ pw_uid }}-b" name="{{ pw_confirm_name }}" class="{{ pw_input_class }}"
                       autocomplete="new-password" {% if pw_required %}required{% endif %}
                       placeholder="••••••••" data-pw="confirm">
                <button type="button" class="pw-eye" data-pw-toggle="{{ pw_uid }}-b"
                        aria-label="Ver a senha" title="Ver a senha" aria-pressed="false">
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" data-pw-icon="open">
                        <path fill="none" stroke="currentColor" stroke-width="1.7" d="M1.8 12S5.5 5.5 12 5.5 22.2 12 22.2 12 18.5 18.5 12 18.5 1.8 12 1.8 12Z"/>
                        <circle cx="12" cy="12" r="3.2" fill="none" stroke="currentColor" stroke-width="1.7"/>
                    </svg>
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" data-pw-icon="closed" style="display:none">
                        <path fill="none" stroke="currentColor" stroke-width="1.7" d="M1.8 12S5.5 5.5 12 5.5 22.2 12 22.2 12 18.5 18.5 12 18.5 1.8 12 1.8 12Z"/>
                        <circle cx="12" cy="12" r="3.2" fill="none" stroke="currentColor" stroke-width="1.7"/>
                        <path stroke="currentColor" stroke-width="1.7" d="M4 20 20 4"/>
                    </svg>
                </button>
            </div>
        </div>
    </div>

    {% if hint is defined and hint %}<p class="pw-hint">{{ hint }}</p>{% endif %}

    <ul class="pw-list" aria-live="polite">
        {% for requirement in password_requirements() %}
            <li class="pw-item" data-pw-rule="{{ requirement.key }}" data-pw-regex="{{ requirement.regex }}">
                <span class="pw-mark" aria-hidden="true"></span><span>{{ requirement.label }}</span>
            </li>
        {% endfor %}
        <li class="pw-item" data-pw-rule="match">
            <span class="pw-mark" aria-hidden="true"></span><span>As duas senhas são iguais</span>
        </li>
    </ul>
</div>

<style>
.pw-fields{display:flex;flex-direction:column;gap:.6rem}
.pw-fields .pw-row{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
@media(max-width:640px){.pw-fields .pw-row{grid-template-columns:1fr}}
.pw-fields .pw-field{display:flex;flex-direction:column;gap:.35rem}
.pw-fields .pw-input{position:relative;display:block}
.pw-fields .pw-input input{width:100%;padding-right:2.6rem}
.pw-fields .pw-eye{position:absolute;top:50%;right:.5rem;transform:translateY(-50%);display:flex;align-items:center;justify-content:center;width:2rem;height:2rem;padding:0;background:none;border:0;border-radius:6px;cursor:pointer;color:currentColor;opacity:.6}
.pw-fields .pw-eye:hover,.pw-fields .pw-eye:focus-visible{opacity:1}
.pw-fields .pw-hint{font-size:.78rem;opacity:.65;margin:0}
.pw-fields .pw-list{list-style:none;margin:.1rem 0 0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:.2rem .9rem;font-size:.8rem}
.pw-fields.pw-stacked .pw-row,.pw-fields.pw-stacked .pw-list{grid-template-columns:1fr}
@media(max-width:640px){.pw-fields .pw-list{grid-template-columns:1fr}}
.pw-fields .pw-item{display:flex;align-items:center;gap:.45rem;opacity:.65}
.pw-fields .pw-mark{display:inline-flex;align-items:center;justify-content:center;width:1.05rem;height:1.05rem;flex:0 0 1.05rem;border-radius:50%;border:1px solid currentColor;font-size:.7rem;line-height:1}
.pw-fields .pw-mark::before{content:'·'}
.pw-fields .pw-item.pw-ok{opacity:1;color:#22c55e}
.pw-fields .pw-item.pw-ok .pw-mark{border-color:#22c55e}
.pw-fields .pw-item.pw-ok .pw-mark::before{content:'✓'}
.pw-fields .pw-item.pw-bad{opacity:1;color:#ef4444}
.pw-fields .pw-item.pw-bad .pw-mark{border-color:#ef4444}
.pw-fields .pw-item.pw-bad .pw-mark::before{content:'!'}
</style>

<script>
(function () {
    var box = document.getElementById('{{ pw_uid }}');
    if (!box) { return; }

    var main = box.querySelector('[data-pw="main"]');
    var confirm = box.querySelector('[data-pw="confirm"]');
    var items = box.querySelectorAll('.pw-item');
    var minLength = parseInt(box.getAttribute('data-min-length'), 10) || 9;
    var senhaObrigatoria = box.getAttribute('data-required') === '1';
    var form = box.closest('form');
    var submits = form ? form.querySelectorAll('button[type="submit"], input[type="submit"]') : [];

    // Mesma regra do servidor: o tamanho conta caracteres, não bytes
    function conta(valor) { return Array.from(valor).length; }

    function cumpre(item, valor) {
        var regra = item.getAttribute('data-pw-rule');
        if (regra === 'length') { return conta(valor) >= minLength; }
        if (regra === 'match') { return valor !== '' && valor === confirm.value; }
        try {
            return new RegExp(item.getAttribute('data-pw-regex'), 'u').test(valor);
        } catch (e) {
            return true; // navegador sem \p{...}: quem decide é o servidor
        }
    }

    var tocado = false;

    function confere() {
        var valor = main.value;
        var vazio = valor === '' && confirm.value === '';
        var tudoOk = true;

        items.forEach(function (item) {
            item.classList.remove('pw-ok', 'pw-bad');
            var ok = cumpre(item, valor);
            if (!ok) { tudoOk = false; }
            // Antes de digitar, e quando a senha opcional fica em branco, os itens ficam
            // apenas pendentes: ninguém vê vermelho num formulário que acabou de abrir
            if (!tocado || (vazio && !senhaObrigatoria)) { return; }
            item.classList.add(ok ? 'pw-ok' : 'pw-bad');
        });

        var liberado = (vazio && !senhaObrigatoria) || tudoOk;
        submits.forEach(function (botao) {
            botao.disabled = !liberado;
            botao.setAttribute('aria-disabled', liberado ? 'false' : 'true');
        });

        return liberado;
    }

    function aoDigitar() {
        tocado = true;
        confere();
    }

    ['input', 'change', 'keyup'].forEach(function (evento) {
        main.addEventListener(evento, aoDigitar);
        confirm.addEventListener(evento, aoDigitar);
    });
    // O 'paste' chega antes de o valor entrar no campo: o 'input' que vem depois faz a conta
    ['paste', 'blur'].forEach(function (evento) {
        main.addEventListener(evento, function () { tocado = true; });
        confirm.addEventListener(evento, function () { tocado = true; });
    });

    box.querySelectorAll('[data-pw-toggle]').forEach(function (botao) {
        botao.addEventListener('click', function () {
            var campo = document.getElementById(botao.getAttribute('data-pw-toggle'));
            var vendo = campo.type === 'text';
            campo.type = vendo ? 'password' : 'text';
            botao.setAttribute('aria-pressed', vendo ? 'false' : 'true');
            botao.setAttribute('aria-label', vendo ? 'Ver a senha' : 'Ocultar a senha');
            botao.setAttribute('title', vendo ? 'Ver a senha' : 'Ocultar a senha');
            botao.querySelector('[data-pw-icon="open"]').style.display = vendo ? '' : 'none';
            botao.querySelector('[data-pw-icon="closed"]').style.display = vendo ? 'none' : '';
            campo.focus();
        });
    });

    if (form) {
        form.addEventListener('submit', function (evento) {
            tocado = true;
            if (!confere()) { evento.preventDefault(); }
        });
    }

    confere();
})();
</script>

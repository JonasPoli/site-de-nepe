{% extends 'superadmin/base.html.twig' %}
{% block title %}Super Admin — Dashboard{% endblock %}
{% block page_title %}Painel Global{% endblock %}

{% block body %}
<style>
/* Listagem agrupada: identificação visual do NEPE e do usuário */
.sa-search{display:flex;gap:.5rem;align-items:center;margin:1.25rem 0 .5rem;flex-wrap:wrap}
.sa-search input{flex:1;min-width:240px;max-width:460px}
.sa-group{margin-top:1rem}
.sa-group-head{display:flex;align-items:center;gap:.65rem;padding:.6rem .85rem;background:var(--bg3);border-radius:8px 8px 0 0}
.sa-logo{width:28px;height:28px;object-fit:contain;border-radius:6px;background:#fff;padding:2px;flex:none}
.sa-logo-fallback{width:28px;height:28px;border-radius:6px;display:flex;align-items:center;justify-content:center;background:var(--bg2);color:var(--muted);flex:none}
.sa-group-name{font-weight:700}
.sa-group-count{margin-left:auto;color:var(--muted);font-size:.85rem}
.sa-avatar{width:30px;height:30px;border-radius:50%;object-fit:cover;flex:none}
.sa-initials{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--bg3);color:var(--muted);font-size:.72rem;font-weight:700;flex:none}
.sa-user{display:flex;align-items:center;gap:.6rem}
.sa-empty-group{padding:.9rem;color:var(--muted);font-size:.88rem}
.sa-warn-row td{background:rgba(255,170,0,.07)}
.sa-note{font-size:.78rem;color:var(--muted);display:block;margin-top:.15rem}
.sa-missing{color:var(--muted);font-style:italic}
</style>

<div class="stats">
    <div class="stat">
        <div class="stat-icon" style="color:var(--primary)"><sl-icon name="building"></sl-icon></div>
        <div class="stat-val">{{ totalTenants }}</div>
        <div class="stat-lbl">Tenants</div>
    </div>
    <div class="stat">
        <div class="stat-icon" style="color:var(--secondary)"><sl-icon name="people-fill"></sl-icon></div>
        <div class="stat-val">{{ totalUsers }}</div>
        <div class="stat-lbl">Usuários</div>
    </div>
</div>

{# ── BUSCA ── #}
<form method="get" action="{{ path('superadmin_dash') }}" class="sa-search">
    <input type="search" name="q" class="ai" value="{{ busca }}"
           placeholder="Buscar NEPE (nome ou domínio) ou usuário (nome, login ou e-mail)">
    <button type="submit" class="btn btn-p btn-sm"><sl-icon name="search"></sl-icon> Buscar</button>
    {% if busca %}
        <a href="{{ path('superadmin_dash') }}" class="btn btn-g btn-sm">Limpar</a>
    {% endif %}
</form>

{% if busca %}
    <p class="af-hint" style="margin-bottom:.75rem">Mostrando o que corresponde a <strong>{{ busca }}</strong>.</p>
{% endif %}

{# ── TENANTS ── #}
<div id="tenants" class="ph" style="margin-top:1rem">
    <h2 style="font-size:1.1rem;font-weight:700">Tenants</h2>
    <div class="ta">
        <a href="{{ path('superadmin_tenant_export') }}" class="btn btn-g btn-sm"
           title="Baixa um CSV com os NEPEs e os administradores, no mesmo formato que a importação lê.">
            <sl-icon name="download"></sl-icon> Exportar CSV
        </a>
        <a href="{{ path('superadmin_tenant_import') }}" class="btn btn-g btn-sm">
            <sl-icon name="file-earmark-spreadsheet"></sl-icon> Importar CSV
        </a>
        <a href="{{ path('superadmin_tenant_onboard') }}" class="btn btn-g btn-sm">
            <sl-icon name="person-badge"></sl-icon> Cadastrar NEPE + Admin
        </a>
        <a href="{{ path('superadmin_tenant_new') }}" class="btn btn-p btn-sm">
            <sl-icon name="plus-lg"></sl-icon> Novo Tenant
        </a>
    </div>
</div>
<p class="af-hint" style="margin:-.35rem 0 .6rem">
    O arquivo exportado traz nome e e-mail dos administradores: trate-o como dado pessoal.
    Ele cobre os NEPEs e os administradores, não todos os usuários.
</p>
<div class="card">
    <div class="tw"><table class="at">
        <thead><tr><th></th><th>Nome</th><th>Domínio</th><th>Usuários</th><th>Aprovações</th><th>Tema</th><th></th></tr></thead>
        <tbody>
        {% for row in tenantRows %}
        {% set t = row.tenant %}
        <tr{% if row.users == 0 %} class="sa-warn-row"{% endif %}>
            <td style="width:40px">
                {% if t.logo %}
                    <img class="sa-logo" src="{{ vich_uploader_asset(t, 'logoFile') }}" alt="">
                {% else %}
                    <span class="sa-logo-fallback"><sl-icon name="building"></sl-icon></span>
                {% endif %}
            </td>
            <td style="font-weight:700">{{ t.name }}</td>
            <td>{{ t.domain ?? '—' }}</td>
            <td>
                {{ row.users }}
                {% if row.users == 0 %}<span class="sa-note">sem administrador</span>{% endif %}
            </td>
            <td>{{ t.requiredApprovals ?? 1 }}</td>
            <td><span class="badge bg-neu">{{ t.theme ?? 'nepe' }}</span></td>
            <td><div class="ta">
                <a href="{{ path('superadmin_tenant_edit', {id: t.id}) }}" class="btn btn-g btn-sm"><sl-icon name="pencil-fill"></sl-icon></a>
                <form action="{{ path('superadmin_tenant_delete', {id: t.id}) }}" method="post" onsubmit="return confirm('Remover o tenant, os usuários dele e TODOS os dados?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('del_tenant_' ~ t.id) }}">
                    <button class="btn btn-d btn-sm"><sl-icon name="trash-fill"></sl-icon></button>
                </form>
            </div></td>
        </tr>
        {% else %}
        <tr><td colspan="7" style="text-align:center;color:var(--muted);padding:2rem">
            {% if busca %}Nenhum NEPE corresponde à busca.{% else %}Nenhum tenant cadastrado.{% endif %}
        </td></tr>
        {% endfor %}
        </tbody>
    </table></div>
</div>

{# ── USUÁRIOS, AGRUPADOS POR NEPE ── #}
<div id="users" class="ph" style="margin-top:2rem">
    <h2 style="font-size:1.1rem;font-weight:700">Usuários</h2>
    <a href="{{ path('superadmin_user_new') }}" class="btn btn-p btn-sm">
        <sl-icon name="plus-lg"></sl-icon> Novo Usuário
    </a>
</div>

{% set gruposComUsuario = userGroups|filter(g => g.users is not empty) %}

{% if gruposComUsuario is empty %}
    <div class="card"><div class="sa-empty-group" style="text-align:center;padding:2rem">
        {% if busca %}
            Nenhum usuário corresponde à busca. <a href="{{ path('superadmin_dash') }}">Limpar a busca</a>.
        {% else %}
            Nenhum usuário.
        {% endif %}
    </div></div>
{% endif %}

{% for grupo in (busca ? gruposComUsuario : userGroups) %}
    <div class="sa-group">
        <div class="sa-group-head">
            {% if grupo.tenant %}
                {% if grupo.tenant.logo %}
                    <img class="sa-logo" src="{{ vich_uploader_asset(grupo.tenant, 'logoFile') }}" alt="">
                {% else %}
                    <span class="sa-logo-fallback"><sl-icon name="building"></sl-icon></span>
                {% endif %}
                <span class="sa-group-name">{{ grupo.tenant.name }}</span>
                <span class="badge bg-neu">{{ grupo.tenant.domain }}</span>
            {% else %}
                <span class="sa-logo-fallback"><sl-icon name="shield-fill"></sl-icon></span>
                <span class="sa-group-name">Sem NEPE (acesso global)</span>
            {% endif %}
            <span class="sa-group-count">{{ grupo.users|length }} usuário(s)</span>
        </div>
        <div class="card" style="border-radius:0 0 8px 8px;margin-top:0">
            {% if grupo.users is empty %}
                <div class="sa-empty-group">Nenhum usuário neste NEPE — ninguém administra este site.</div>
            {% else %}
            <div class="tw"><table class="at">
                <thead><tr><th>Nome</th><th>Login</th><th>E-mail</th><th>Função</th><th></th></tr></thead>
                <tbody>
                {% for u in grupo.users %}
                {% set papel = u.panelRole %}
                <tr{% if papel.isInconsistent %} class="sa-warn-row"{% endif %}>
                    <td>
                        <div class="sa-user">
                            {% if u.photo %}
                                <img class="sa-avatar" src="{{ vich_uploader_asset(u, 'photoFile') }}" alt="">
                            {% elseif u.initials %}
                                <span class="sa-initials">{{ u.initials }}</span>
                            {% else %}
                                <span class="sa-initials"><sl-icon name="person-fill"></sl-icon></span>
                            {% endif %}
                            <span style="font-weight:600">
                                {% if u.name %}{{ u.name }}{% else %}<span class="sa-missing">sem nome</span>{% endif %}
                            </span>
                        </div>
                    </td>
                    <td><code style="background:var(--bg3);padding:.15rem .5rem;border-radius:4px;font-size:.8rem">{{ u.username }}</code></td>
                    <td>{% if u.email %}{{ u.email }}{% else %}<span class="sa-missing">sem e-mail</span>{% endif %}</td>
                    <td>
                        {% if papel.value == 'super_admin' %}
                            <span class="badge bg-inf"><sl-icon name="shield-fill" style="font-size:.65rem;margin-right:.3rem"></sl-icon> {{ papel.label }}</span>
                        {% elseif papel.value == 'admin' %}
                            <span class="badge bg-ok">{{ papel.label }}</span>
                        {% elseif papel.value == 'editor' %}
                            <span class="badge bg-neu">{{ papel.label }}</span>
                        {% elseif papel.value == 'reviewer' %}
                            <span class="badge bg-warn">{{ papel.label }}</span>
                        {% else %}
                            <span class="badge bg-warn"><sl-icon name="exclamation-triangle-fill" style="font-size:.65rem;margin-right:.3rem"></sl-icon> {{ papel.label }}</span>
                            <span class="sa-note">sem NEPE e fora do grupo 0: não entra em painel nenhum</span>
                        {% endif %}
                    </td>
                    <td><div class="ta">
                        <a href="{{ path('superadmin_impersonate', {id: u.id}) }}" class="btn btn-g btn-sm" title="Acessar como este usuário">
                            <sl-icon name="person-fill-check"></sl-icon>
                        </a>
                        <a href="{{ path('superadmin_user_edit', {id: u.id}) }}" class="btn btn-g btn-sm"><sl-icon name="pencil-fill"></sl-icon></a>
                        <form action="{{ path('superadmin_user_delete', {id: u.id}) }}" method="post" onsubmit="return confirm('Remover usuário?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('del_user_' ~ u.id) }}">
                            <button class="btn btn-d btn-sm"><sl-icon name="trash-fill"></sl-icon></button>
                        </form>
                    </div></td>
                </tr>
                {% endfor %}
                </tbody>
            </table></div>
            {% endif %}
        </div>
    </div>
{% endfor %}
{% endblock %}

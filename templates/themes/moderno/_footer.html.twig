<footer class="moderno-footer">
<div class="mf-glow"></div>
<div class="container mf-grid">

    {# Col 1 — Brand + Redes Sociais #}
    <div class="mf-col mf-brand">
        {% if currentTenant and currentTenant.darkLogo %}
            <img src="{{ asset('uploads/tenant/logo/' ~ currentTenant.darkLogo) }}"
                 alt="{{ currentTenant.name }}"
                 style="height:44px;width:auto;object-fit:contain;margin-bottom:1rem">
        {% elseif currentTenant and currentTenant.logo %}
            <img src="{{ asset('uploads/tenant/logo/' ~ currentTenant.logo) }}"
                 alt="{{ currentTenant.name }}"
                 style="height:44px;width:auto;object-fit:contain;margin-bottom:1rem;filter:brightness(0) invert(1)">
        {% else %}
            <span class="mf-logo-text">{{ currentTenant ? currentTenant.name : 'NEPE Brasil' }}</span>
        {% endif %}
        {% if currentTenant and currentTenant.aboutText %}
            {% set firstSentence = currentTenant.aboutText|split('.')[0] ~ '.' %}
            <p class="mf-tagline">{{ firstSentence }}</p>
        {% else %}
            <p class="mf-tagline">Conhecimento que transforma.</p>
        {% endif %}
        <div class="mf-social">
            {% if currentTenant and currentTenant.youtubeLink %}<a href="{{ currentTenant.youtubeLink }}" target="_blank" rel="noopener" aria-label="YouTube" class="mf-social-link"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg></a>{% endif %}
            {% if currentTenant and currentTenant.instagramLink %}<a href="{{ currentTenant.instagramLink }}" target="_blank" rel="noopener" aria-label="Instagram" class="mf-social-link"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg></a>{% endif %}
            {% if currentTenant and currentTenant.facebookLink %}<a href="{{ currentTenant.facebookLink }}" target="_blank" rel="noopener" aria-label="Facebook" class="mf-social-link"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg></a>{% endif %}
            {% if currentTenant and currentTenant.linkedinLink %}<a href="{{ currentTenant.linkedinLink }}" target="_blank" rel="noopener" aria-label="LinkedIn" class="mf-social-link"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a>{% endif %}
            {% if currentTenant and currentTenant.whatsappLink %}<a href="{{ currentTenant.whatsappLink }}" target="_blank" rel="noopener" aria-label="WhatsApp" class="mf-social-link"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg></a>{% endif %}
        </div>
    </div>

    {# Col 2 — Institucional #}
    <div class="mf-col">
        <h4 class="mf-col-title">Institucional</h4>
        <nav class="mf-nav">
            {% for page in footerPages %}<a href="{{ path('pub_page_show', {slug: page.slug}) }}">{{ page.title }}</a>{% else %}<span style="color:rgba(255,255,255,.2)">—</span>{% endfor %}
        </nav>
    </div>

    {# Col 3 — Notícias #}
    <div class="mf-col">
        <h4 class="mf-col-title">Artigos</h4>
        <nav class="mf-nav">
            <a href="{{ path('pub_articles') }}">Todos os artigos</a>
            {% for cat in footerCategories %}<a href="{{ path('pub_articles') }}">{{ cat.name }}</a>{% endfor %}
        </nav>
    </div>

    {# Col 4 — Vídeos #}
    <div class="mf-col">
        <h4 class="mf-col-title">Vídeos</h4>
        <nav class="mf-nav">
            <a href="{{ path('pub_videos') }}">Todos os vídeos</a>
            {% for video in footerVideos %}<a href="{{ path('pub_video_show', {slug: video.slug}) }}">{{ video.title|slice(0,38) }}{% if video.title|length > 38 %}…{% endif %}</a>{% endfor %}
        </nav>
    </div>

</div>
<div class="mf-bottom">
    <p>&copy; {{ "now"|date("Y") }} {{ currentTenant ? currentTenant.name : 'NEPE Brasil' }}. Todos os direitos reservados.</p>
</div>
</footer>
<style>
.moderno-footer { background:#060612; position:relative; overflow:hidden; padding-top:5rem; }
.mf-glow { position:absolute; top:0; left:50%; transform:translateX(-50%); width:600px; height:300px; background:radial-gradient(ellipse at top,rgba(var(--color-primary-rgb),.15),transparent 70%); pointer-events:none; }
.mf-grid { display:grid; grid-template-columns:1.6fr 1fr 1fr 1fr; gap:3rem; padding-bottom:3rem; align-items:start; }
.mf-col-title { font-size:.7rem; font-weight:800; text-transform:uppercase; letter-spacing:.1em; color:rgba(255,255,255,.7); margin:0 0 1rem; }
.mf-logo-text { font-size:1.5rem; font-weight:900; display:block; margin-bottom:.75rem; background:linear-gradient(135deg,var(--color-secondary),var(--color-primary)); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
.mf-tagline { color:rgba(255,255,255,.35); font-size:.85rem; margin:.25rem 0 1.25rem; line-height:1.6; }
.mf-social { display:flex; gap:.75rem; flex-wrap:wrap; }
.mf-social-link { color:rgba(255,255,255,.4); transition:color .2s; }
.mf-social-link:hover { color:var(--color-secondary); }
.mf-nav { display:flex; flex-direction:column; gap:.5rem; }
.mf-nav a { color:rgba(255,255,255,.4); font-size:.875rem; transition:color .2s; text-decoration:none; }
.mf-nav a:hover { color:var(--color-secondary); }
.mf-bottom { border-top:1px solid rgba(255,255,255,.06); text-align:center; padding:1.25rem; font-size:.8rem; color:rgba(255,255,255,.25); }
@media(max-width:900px){ .mf-grid{ grid-template-columns:1fr 1fr; gap:2rem; } }
@media(max-width:560px){ .mf-grid{ grid-template-columns:1fr; } }
</style>

{% extends 'themes/moderno/base.html.twig' %}
{% block title %}{{ page.seoTitle ?? page.title }}{% endblock %}
{% block body %}
<div class="mp-hero"><div class="container"><h1>{{ page.title }}</h1></div></div>
{% for section in page.sections %}{% if section.active %}
<section class="mp-section">
    {% if section.titlePart1 or section.titlePart2 %}
    <div class="mp-two-tone">
        {% if section.titlePart1 %}<span class="mp-t1">{{ section.titlePart1 }}</span>{% endif %}
        {% if section.titlePart2 %}<span class="mp-t2">{{ section.titlePart2 }}</span>{% endif %}
    </div>
    {% endif %}
    {% for block in section.blocks %}
    {% if block.type == 'text_only' %}
    {# ── Apenas Texto: largura total, sem grid ── #}
    {% set align = block.config ? (block.config.textAlign ?? 'left') : 'left' %}
    {% set mwKey = block.config ? (block.config.maxWidth ?? 'full') : 'full' %}
    {% set mw    = mwKey == 'narrow' ? '600px' : (mwKey == 'wide' ? '800px' : '100%') %}
    <div class="mp-text-only" style="text-align:{{ align }};max-width:{{ mw }};">
        {% if block.preTitle %}<span class="section-label"><span class="glow-dot"></span>{{ block.preTitle }}</span>{% endif %}
        {% if block.title %}<h2>{{ block.title }}</h2>{% endif %}
        {% if block.text %}<div class="prose-dark">{{ block.text|raw }}</div>{% endif %}
        {% if block.config and (block.config.ctaText ?? null) and (block.config.ctaLink ?? null) %}
            <a href="{{ block.config.ctaLink }}" class="mp-cta-btn">{{ block.config.ctaText }}</a>
        {% endif %}
    </div>
    {% elseif block.type == 'banner' %}
    {# ── Banner / Slider ── #}
    {% set bSlides = [] %}
    {% if block.config.banners is defined and block.config.banners is not empty %}
        {% for b in block.config.banners %}
            {% if (b.active ?? '1') == '1' %}{% set bSlides = bSlides|merge([b]) %}{% endif %}
        {% endfor %}
    {% endif %}
    {% if bSlides is empty and block.title is not empty %}
        {% set bSlides = [{'title': block.title,'text': block.text,'ctaText': block.config.ctaText ?? '','ctaLink': block.config.ctaLink ?? '','image': block.image}] %}
    {% endif %}
    {% if bSlides is not empty %}
    {% if bSlides|length == 1 %}
    {% set b = bSlides[0] %}
    {% set hasContent = b.title or b.text or b.ctaText or block.preTitle %}
    <div class="mp-banner-block">
        {% if b.image %}
            <div class="mpb-bg" style="background-image:url('/uploads/page_block/{{ b.image }}')"></div>
            {% if hasContent %}<div class="mpb-overlay"></div>{% endif %}
        {% else %}
            <div class="mpb-gradient"></div>
        {% endif %}
        {% if hasContent %}
        <div class="mpb-content">
            {% if block.preTitle %}<span class="mpb-pretitle">{{ block.preTitle }}</span>{% endif %}
            {% if b.title %}<h2 class="mpb-title">{{ b.title }}</h2>{% endif %}
            {% if b.text %}<p class="mpb-text">{{ b.text }}</p>{% endif %}
            {% if b.ctaText %}<a href="{{ b.ctaLink ?: '#' }}" class="mpb-cta">{{ b.ctaText }}</a>{% endif %}
        </div>
        {% endif %}
    </div>
    {% else %}
    <div class="mp-banner-block swiper mpb-swiper-{{ block.id }}">
        <div class="swiper-wrapper">
            {% for b in bSlides %}
            <div class="swiper-slide mpb-slide">
                {% set hasContent = b.title or b.text or b.ctaText or block.preTitle %}
                {% if b.image %}
                    <div class="mpb-bg" style="background-image:url('/uploads/page_block/{{ b.image }}')"></div>
                    {% if hasContent %}<div class="mpb-overlay"></div>{% endif %}
                {% else %}
                    <div class="mpb-gradient"></div>
                {% endif %}
                {% if hasContent %}
                <div class="mpb-content">
                    {% if block.preTitle %}<span class="mpb-pretitle">{{ block.preTitle }}</span>{% endif %}
                    {% if b.title %}<h2 class="mpb-title">{{ b.title }}</h2>{% endif %}
                    {% if b.text %}<p class="mpb-text">{{ b.text }}</p>{% endif %}
                    {% if b.ctaText %}<a href="{{ b.ctaLink ?: '#' }}" class="mpb-cta">{{ b.ctaText }}</a>{% endif %}
                </div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        <div class="swiper-pagination swiper-pagination-{{ block.id }}"></div>
        <div class="swiper-button-next swiper-button-next-{{ block.id }}"></div>
        <div class="swiper-button-prev swiper-button-prev-{{ block.id }}"></div>
    </div>
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        if (typeof Swiper !== 'undefined') {
            new Swiper('.mpb-swiper-{{ block.id }}', {
                loop: true, effect: 'fade', fadeEffect: { crossFade: true },
                autoplay: { delay: 5000, disableOnInteraction: false },
                pagination: { el: '.swiper-pagination-{{ block.id }}', clickable: true },
                navigation: { nextEl: '.swiper-button-next-{{ block.id }}', prevEl: '.swiper-button-prev-{{ block.id }}' }
            });
        }
    });
    </script>
    {% endif %}
    {% endif %}
    {% else %}
    {# ── Default: zigzag (text_image e outros) ── #}
    <div class="mp-block {% if loop.index is even %}mp-reverse{% endif %}">
        {% if block.image %}<div class="mp-block-img"><img src="/uploads/page_block/{{ block.image }}" alt="{{ block.title ?? '' }}" loading="lazy"></div>{% endif %}
        <div class="mp-block-text">
            {% if block.preTitle %}<span class="section-label"><span class="glow-dot"></span>{{ block.preTitle }}</span>{% endif %}
            {% if block.title %}<h2>{{ block.title }}</h2>{% endif %}
            {% if block.text %}<div class="prose-dark">{{ block.text|raw }}</div>{% endif %}
        </div>
    </div>
    {% endif %}
    {% endfor %}
</section>
{% endif %}{% endfor %}
{% endblock %}
{% block stylesheets %}{{ parent() }}<style>
.mp-hero{background:linear-gradient(135deg,rgba(var(--color-primary-rgb),.2),rgba(var(--color-secondary-rgb),.1));padding:5rem 0;text-align:center;border-bottom:1px solid rgba(255,255,255,.06);}
.mp-hero h1{font-size:clamp(2rem,5vw,3.5rem);font-weight:900;background:linear-gradient(135deg,#fff,color-mix(in srgb,var(--color-secondary) 70%,#fff));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.mp-section{padding:5rem 0;border-bottom:1px solid rgba(255,255,255,.04);}
.mp-two-tone{display:flex;justify-content:center;margin-bottom:3rem;border-radius:var(--radius);overflow:hidden;}
.mp-t1{background:var(--color-secondary);color:#060612;padding:.75rem 2rem;font-size:1.3rem;font-weight:800;}
.mp-t2{background:var(--color-primary);color:#fff;padding:.75rem 2rem;font-size:1.3rem;font-weight:800;}
.mp-block{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center;max-width:1100px;margin:0 auto 4rem;padding:0 1.5rem;}
.mp-reverse .mp-block-img{order:2;}
.mp-reverse .mp-block-text{order:1;}
.mp-block-img img{border-radius:var(--radius);border:1px solid rgba(255,255,255,.08);}
.mp-block-text h2{font-size:1.7rem;font-weight:800;color:#e2e8f0;margin:.75rem 0 1rem;}
.prose-dark{color:rgba(255,255,255,.65);line-height:1.8;}
.prose-dark a{color:var(--color-secondary);}
/* ── Apenas Texto ── */
.mp-text-only{max-width:100%;margin:0 auto 4rem;padding:0 1.5rem;}
.mp-text-only h2{font-size:1.7rem;font-weight:800;color:#e2e8f0;margin:.75rem 0 1rem;}
.mp-cta-btn{display:inline-flex;align-items:center;margin-top:1.5rem;background:var(--color-primary);color:#fff;padding:.75rem 2rem;border-radius:50px;font-weight:700;font-size:.9rem;text-decoration:none;transition:background .2s,transform .2s;box-shadow:0 4px 14px rgba(0,0,0,.25);}
.mp-cta-btn:hover{background:var(--color-secondary);color:#060612;transform:translateY(-2px);}
/* ── Banner Moderno ── */
.mp-banner-block{position:relative;overflow:hidden;border-radius:16px;min-height:380px;margin-bottom:3rem;display:flex;align-items:center;justify-content:center;border:1px solid rgba(255,255,255,.08);}
.mpb-bg{position:absolute;inset:0;background-size:cover;background-position:center;transition:transform .6s ease;z-index:0;}
.mp-banner-block:hover .mpb-bg{transform:scale(1.03);}
.mpb-overlay{position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(0,0,0,.18) 0%,rgba(0,0,0,.65) 100%);}
.mpb-gradient{position:absolute;inset:0;z-index:0;background:linear-gradient(135deg,var(--color-primary),var(--color-secondary));opacity:.85;}
.mpb-content{position:relative;z-index:2;text-align:center;max-width:800px;width:100%;padding:3rem 2rem;color:#fff;background:rgba(15,23,42,.35);border-radius:12px;backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.1);margin:2rem auto;}
.mpb-pretitle{display:inline-block;text-transform:uppercase;letter-spacing:2px;font-size:.8rem;font-weight:700;margin-bottom:1rem;color:var(--color-secondary);background:rgba(0,0,0,.4);padding:.35rem 1rem;border-radius:50px;backdrop-filter:blur(4px);}
.mpb-title{font-size:clamp(1.75rem,4vw,2.75rem);font-weight:900;line-height:1.2;margin-bottom:1rem;text-shadow:0 2px 10px rgba(0,0,0,.5);color:#fff;}
.mpb-text{font-size:clamp(1rem,2vw,1.15rem);opacity:.9;line-height:1.6;margin-bottom:2rem;text-shadow:0 1px 5px rgba(0,0,0,.4);color:#f1f5f9;}
.mpb-cta{display:inline-flex;align-items:center;background:var(--color-primary);color:#fff;padding:.8rem 2.2rem;border-radius:8px;font-weight:700;text-decoration:none;box-shadow:0 4px 15px rgba(0,0,0,.3);transition:background .2s,transform .2s;}
.mpb-cta:hover{background:var(--color-secondary);color:#1a1c2e;transform:translateY(-2px);}
.mpb-slide{position:relative;min-height:380px;display:flex;align-items:center;justify-content:center;box-sizing:border-box;padding:1.5rem;}
@media(max-width:768px){.mp-block{grid-template-columns:1fr;}.mp-reverse .mp-block-img,.mp-reverse .mp-block-text{order:unset;}.mp-two-tone{flex-direction:column;}}
</style>{% endblock %}

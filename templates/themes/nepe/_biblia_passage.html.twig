{#
  Trecho bíblico referenciado pelo conteúdo, exibido em destaque.
  Variável: passage (retorno de BibliaService::getPassage)
#}
{% set places = [] %}
{% set years = [] %}
{% for v in passage.verses %}
    {% if v.ext and v.ext.place and v.ext.place not in places %}{% set places = places|merge([v.ext.place]) %}{% endif %}
    {% set year = v.ext ? (v.ext.year_description ?: v.ext.year) : null %}
    {% if year and year not in years %}{% set years = years|merge([year]) %}{% endif %}
{% endfor %}

<section class="biblia-passage" aria-label="Texto bíblico de referência">
    <header class="biblia-passage__head">
        <span class="biblia-passage__icon" aria-hidden="true">📖</span>
        <div>
            <span class="biblia-passage__label">Texto bíblico de referência</span>
            <h2 class="biblia-passage__ref">{{ passage.reference_formatted }}</h2>
        </div>
        <span class="biblia-passage__version" title="{{ passage.version.name }}">{{ passage.version.abbrev }}</span>
    </header>

    <div class="biblia-passage__text">
        {% set previousSubject = null %}
        {% for v in passage.verses %}
            {% if v.subject and v.subject != previousSubject %}
                <h3 class="biblia-passage__subject">{{ v.subject }}</h3>
            {% endif %}
            {% set previousSubject = v.subject %}
            <span class="biblia-passage__verse"><sup>{{ v.verse }}</sup>{{ v.text }}</span>
        {% endfor %}
    </div>

    {% if places or years %}
    <footer class="biblia-passage__meta">
        {% if places %}<span>📍 {{ places|join(', ') }}</span>{% endif %}
        {% if years %}<span>🗓️ {{ years|join(', ') }}</span>{% endif %}
    </footer>
    {% endif %}
</section>

<style>
.biblia-passage {
    margin: 2rem 0 2.5rem; padding: 1.75rem 2rem; border-radius: var(--radius, 16px);
    background: linear-gradient(135deg,
        color-mix(in srgb, var(--color-primary) 8%, white),
        color-mix(in srgb, var(--color-secondary) 6%, white));
    border-left: 5px solid var(--color-primary);
    box-shadow: 0 10px 30px rgba(0,0,0,.06);
}
.biblia-passage__head { display: flex; align-items: center; gap: .9rem; margin-bottom: 1.1rem; }
.biblia-passage__icon { font-size: 1.6rem; line-height: 1; }
.biblia-passage__label {
    display: block; font-size: .7rem; font-weight: 800; text-transform: uppercase;
    letter-spacing: .09em; color: var(--color-primary);
}
.biblia-passage__ref { margin: .15rem 0 0; font-size: 1.35rem; font-weight: 800; color: #1a1c2e; }
.biblia-passage__version {
    margin-left: auto; padding: .2rem .65rem; border-radius: 50px; font-size: .7rem; font-weight: 700;
    color: var(--color-primary); background: color-mix(in srgb, var(--color-primary) 12%, white);
}
.biblia-passage__text { font-family: Georgia, 'Times New Roman', serif; font-size: 1.12rem; line-height: 1.85; color: #2d3142; }
.biblia-passage__subject { margin: 1rem 0 .35rem; font-family: inherit; font-size: .95rem; font-weight: 700; color: #1a1c2e; }
.biblia-passage__subject:first-child { margin-top: 0; }
.biblia-passage__verse sup {
    font-family: system-ui, sans-serif; font-size: .65rem; font-weight: 800;
    color: var(--color-primary); margin: 0 .2rem 0 .15rem;
}
.biblia-passage__meta {
    display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1.1rem; padding-top: .9rem;
    border-top: 1px dashed color-mix(in srgb, var(--color-primary) 25%, transparent);
    font-size: .82rem; color: #6b7280;
}
@media (max-width: 600px) {
    .biblia-passage { padding: 1.25rem; }
    .biblia-passage__text { font-size: 1.02rem; }
}
</style>

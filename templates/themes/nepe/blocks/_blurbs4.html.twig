{% set blurbs = block.config.blurbs ?? [] %}
<div class="nepe-block blurbs4-block reveal-up">
    {% if block.preTitle %}<span class="pre-label">{{ block.preTitle }}</span>{% endif %}
    {% if block.title %}<h2 class="blurbs4-title">{{ block.title }}</h2>{% endif %}
    {% if block.text %}<p class="blurbs4-lead">{{ block.text }}</p>{% endif %}
    {% if blurbs|length > 0 %}
    <div class="blurbs4-grid">
        {% for b in blurbs %}
        {% if b.title or b.icon %}
        <div class="blurbs4-card">
            {% if b.icon %}<div class="blurbs4-icon"><i class="{{ b.icon }}"></i></div>{% endif %}
            {% if b.title %}<h3 class="blurbs4-card-title">{{ b.title }}</h3>{% endif %}
            {% if b.text %}<p class="blurbs4-card-text">{{ b.text }}</p>{% endif %}
        </div>
        {% endif %}
        {% endfor %}
    </div>
    {% endif %}
</div>
<style>
.blurbs4-block{margin:3rem 0;text-align:center}
.blurbs4-title{font-size:clamp(1.75rem,3.5vw,2.5rem);font-weight:800;margin:.5rem 0 1rem}
.blurbs4-lead{color:var(--color-text-muted,#6b7280);max-width:640px;margin:0 auto 2.5rem;font-size:1.05rem;line-height:1.7}
.blurbs4-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1.5rem;text-align:left}
.blurbs4-card{padding:2rem 1.5rem;border:1px solid var(--color-border,#e5e7eb);border-radius:1rem;background:#fff;transition:transform .25s,box-shadow .25s}
.blurbs4-card:hover{transform:translateY(-6px);box-shadow:0 16px 40px rgba(0,0,0,.08)}
.blurbs4-icon{font-size:2rem;color:var(--color-primary);margin-bottom:1rem}
.blurbs4-card-title{font-size:1.05rem;font-weight:700;margin-bottom:.5rem;color:var(--color-text,#111827)}
.blurbs4-card-text{font-size:.9rem;color:var(--color-text-muted,#6b7280);line-height:1.7}
</style>

{% set subs = block.relatedCategory ? block.relatedCategory.children : [] %}
{% if subs|length > 0 %}
<div class="nb-subcats reveal-up">
    {% if block.preTitle or block.title or block.text %}
    <div class="nb-section-header">
        {% if block.preTitle %}<span class="pre-label">{{ block.preTitle }}</span>{% endif %}
        {% if block.title %}<h2 class="nb-section-title">{{ block.title }}</h2>{% endif %}
        {% if block.text %}<p class="nb-section-lead">{{ block.text }}</p>{% endif %}
    </div>
    {% endif %}
    <div class="nb-subcats-grid">
        {% for sub in subs %}
        <a href="{{ path('pub_category_show', {slug: sub.slug}) }}" class="nb-subcat-card reveal-up delay-{{ loop.index0 * 100 }}">
            {% if sub.icon %}<div class="nb-subcat-icon"><i class="{{ sub.icon }}"></i></div>{% endif %}
            <h3 class="nb-subcat-name">{{ sub.name }}</h3>
            {% if sub.description %}<p class="nb-subcat-desc">{{ sub.description|slice(0,100) }}</p>{% endif %}
            <span class="nb-subcat-arrow"><i class="fa-solid fa-arrow-right"></i></span>
        </a>
        {% endfor %}
    </div>
</div>
<style>
.nb-subcats{max-width:1100px;margin:0 auto 4rem;padding:0 1.5rem}
.nb-subcats-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1.25rem}
.nb-subcat-card{display:flex;flex-direction:column;padding:2rem 1.75rem;border-radius:var(--radius);background:#fff;border:1px solid #e8ecf0;box-shadow:0 2px 12px rgba(0,0,0,.04);transition:all .3s ease;text-decoration:none;color:inherit;position:relative}
.nb-subcat-card:hover{transform:translateY(-8px);border-color:color-mix(in srgb,var(--color-primary) 35%,transparent);box-shadow:0 16px 40px rgba(0,0,0,.1);background:color-mix(in srgb,var(--color-primary) 3%,#fff);opacity:1}
.nb-subcat-icon{width:50px;height:50px;border-radius:12px;background:color-mix(in srgb,var(--color-primary) 10%,transparent);color:var(--color-primary);display:flex;align-items:center;justify-content:center;font-size:1.4rem;margin-bottom:1rem;transition:background .3s,transform .3s}
.nb-subcat-card:hover .nb-subcat-icon{background:var(--color-primary);color:#fff;transform:scale(1.1) rotate(-5deg)}
.nb-subcat-name{font-size:1rem;font-weight:700;color:#1a1c2e;margin:0 0 .5rem;line-height:1.3}
.nb-subcat-desc{font-size:.85rem;color:#6b7280;line-height:1.65;margin:0;flex:1}
.nb-subcat-arrow{display:inline-flex;margin-top:1.25rem;color:var(--color-primary);font-size:.85rem;transform:translateX(0);transition:transform .25s}
.nb-subcat-card:hover .nb-subcat-arrow{transform:translateX(5px)}
</style>
{% endif %}

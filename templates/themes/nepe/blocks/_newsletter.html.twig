<div class="nepe-block nepe-newsletter reveal-up">
    {% if block.preTitle %}<span class="pre-label" style="display:block;text-align:center">{{ block.preTitle }}</span>{% endif %}
    {% if block.title %}<h2 style="text-align:center;margin-bottom:.75rem">{{ block.title }}</h2>{% endif %}
    {% if block.text %}<p style="text-align:center;color:var(--color-text-muted,#6b7280);max-width:600px;margin:0 auto 2rem">{{ block.text }}</p>{% endif %}
    <form action="{{ path('pub_newsletter') }}" method="post" class="nl-form">
        <input type="hidden" name="_token" value="{{ csrf_token('newsletter') }}">
        <div class="nl-row">
            <input type="text"  name="name"  class="nl-input" placeholder="Seu nome" required>
            <input type="email" name="email" class="nl-input" placeholder="Seu e-mail" required>
            <button type="submit" class="nl-btn">
                {% if block.config and block.config.buttonText %}{{ block.config.buttonText }}{% else %}Inscrever-se{% endif %}
            </button>
        </div>
    </form>
</div>
<style>
.nepe-newsletter{text-align:center;padding:3rem 2rem;border-radius:1.5rem;background:linear-gradient(135deg,color-mix(in srgb,var(--color-primary) 8%,#fff),color-mix(in srgb,var(--color-secondary,#f59e0b) 6%,#fff));border:1px solid color-mix(in srgb,var(--color-primary) 20%,transparent)}
.nl-form{max-width:640px;margin:0 auto}
.nl-row{display:flex;gap:.75rem;flex-wrap:wrap}
.nl-input{flex:1;min-width:180px;padding:.75rem 1rem;border:1px solid var(--color-border,#d1d5db);border-radius:.6rem;font-size:.95rem;background:#fff}
.nl-input:focus{outline:none;border-color:var(--color-primary);box-shadow:0 0 0 3px color-mix(in srgb,var(--color-primary) 20%,transparent)}
.nl-btn{padding:.75rem 1.75rem;background:var(--color-primary);color:#fff;border:none;border-radius:.6rem;font-weight:700;cursor:pointer;white-space:nowrap;transition:opacity .2s}
.nl-btn:hover{opacity:.88}
</style>

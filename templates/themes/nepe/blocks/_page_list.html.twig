{% set cat = block.relatedCategory %}
<div class="nepe-block reveal-up">
    {% if block.preTitle %}<span class="pre-label">{{ block.preTitle }}</span>{% endif %}
    {% if block.title %}<h2 style="margin-bottom:.5rem">{{ block.title }}</h2>{% endif %}
    {% if block.text %}<p style="color:var(--color-text-muted,#6b7280);margin-bottom:2rem">{{ block.text }}</p>{% endif %}
    {% set pages = cat ? cat.pages : [] %}
    {% if pages|length > 0 %}
    <div class="nepe-page-list">
        {% for page in pages|slice(0, block.itemCount ?? 99) %}
        <a href="{{ path('pub_page_show', {slug: page.slug}) }}" class="npl-card">
            {% if page.coverImage %}
            <div class="npl-img" style="background-image:url('{{ asset('uploads/page_cover/' ~ page.coverImage) }}')"></div>
            {% else %}
            <div class="npl-img npl-placeholder"><i class="fa-solid fa-file-lines"></i></div>
            {% endif %}
            <div class="npl-body">
                <h3 class="npl-title">{{ page.title }}</h3>
                {% if page.seoDescription %}<p class="npl-desc">{{ page.seoDescription|slice(0,120) }}…</p>{% endif %}
                <span class="npl-cta">Ler mais →</span>
            </div>
        </a>
        {% endfor %}
    </div>
    {% else %}
    <p style="color:var(--color-text-muted,#6b7280)">Nenhuma página encontrada.</p>
    {% endif %}
</div>
<style>
.nepe-page-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1.5rem}
.npl-card{display:flex;flex-direction:column;border:1px solid var(--color-border,#e5e7eb);border-radius:1rem;overflow:hidden;background:#fff;transition:transform .25s,box-shadow .25s;text-decoration:none;color:inherit}
.npl-card:hover{transform:translateY(-6px);box-shadow:0 16px 40px rgba(0,0,0,.1)}
.npl-img{height:160px;background-size:cover;background-position:center}
.npl-placeholder{display:flex;align-items:center;justify-content:center;background:#f9fafb;color:var(--color-text-muted,#9ca3af);font-size:2rem}
.npl-body{padding:1.25rem;flex:1;display:flex;flex-direction:column}
.npl-title{font-weight:700;margin-bottom:.5rem;font-size:1rem;color:var(--color-text,#111)}
.npl-desc{font-size:.85rem;color:var(--color-text-muted,#6b7280);flex:1;margin-bottom:.75rem;line-height:1.6}
.npl-cta{color:var(--color-primary);font-weight:600;font-size:.85rem}
</style>

{% set images = block.galleryImages %}
{% if images|length > 0 %}
<div class="nepe-block">
    {% if block.preTitle %}<span class="pre-label">{{ block.preTitle }}</span>{% endif %}
    {% if block.title %}<h2>{{ block.title }}</h2>{% endif %}
    {% if block.text %}<p style="color:var(--color-text-muted,#6b7280);margin:.75rem 0 2rem">{{ block.text }}</p>{% endif %}
    <div class="nepe-gallery" id="gallery-{{ block.id }}">
        <div class="ng-track">
            {% for img in images %}
            <div class="ng-slide" onclick="openLightbox('{{ block.id }}',{{ loop.index0 }})">
                <img src="{{ asset('uploads/page_block_gallery/' ~ img.filename) }}" alt="{{ img.caption }}" loading="lazy">
                {% if img.caption %}<p class="ng-caption">{{ img.caption }}</p>{% endif %}
            </div>
            {% endfor %}
        </div>
        {% if images|length > 1 %}
        <button class="ng-btn ng-prev" onclick="slideGallery('{{ block.id }}',-1)"><i class="fa-solid fa-chevron-left"></i></button>
        <button class="ng-btn ng-next" onclick="slideGallery('{{ block.id }}',1)"><i class="fa-solid fa-chevron-right"></i></button>
        <div class="ng-dots">{% for img in images %}<span class="ng-dot {{ loop.first ? 'active' : '' }}" onclick="goSlide('{{ block.id }}',{{ loop.index0 }})"></span>{% endfor %}</div>
        {% endif %}
    </div>
</div>
<div class="nepe-lightbox" id="lb-{{ block.id }}" style="display:none" onclick="closeLightbox('{{ block.id }}')">
    <button onclick="closeLightbox('{{ block.id }}')" style="position:fixed;top:1rem;right:1.5rem;background:none;border:none;color:#fff;font-size:2rem;cursor:pointer">&times;</button>
    <img id="lb-img-{{ block.id }}" src="" style="max-width:90vw;max-height:88vh;border-radius:12px">
</div>
<style>
.nepe-gallery{position:relative;overflow:hidden;border-radius:1rem}
.ng-track{display:flex;transition:transform .4s ease}
.ng-slide{min-width:100%;cursor:zoom-in}
.ng-slide img{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:1rem}
.ng-caption{text-align:center;font-size:.85rem;color:var(--color-text-muted,#6b7280);padding:.5rem 0}
.ng-btn{position:absolute;top:50%;transform:translateY(-50%);background:rgba(255,255,255,.9);backdrop-filter:blur(8px);border:none;border-radius:50%;width:44px;height:44px;display:flex;align-items:center;justify-content:center;color:#111;cursor:pointer;font-size:1rem;transition:.2s;box-shadow:0 4px 12px rgba(0,0,0,.15)}
.ng-prev{left:.75rem}.ng-next{right:.75rem}
.ng-btn:hover{background:var(--color-primary);color:#fff}
.ng-dots{display:flex;justify-content:center;gap:.5rem;margin-top:1rem}
.ng-dot{width:8px;height:8px;border-radius:50%;background:var(--color-border,#d1d5db);cursor:pointer;transition:.2s}
.ng-dot.active{background:var(--color-primary)}
.nepe-lightbox{position:fixed;inset:0;background:rgba(0,0,0,.9);display:flex;align-items:center;justify-content:center;z-index:9999;cursor:zoom-out}
</style>
<script>
(function(){
window.galleries=window.galleries||{};
window.slideGallery=window.slideGallery||function(id,dir){const g=window.galleries[id]||(window.galleries[id]={idx:0,total:document.querySelectorAll('#gallery-'+id+' .ng-slide').length});g.idx=(g.idx+dir+g.total)%g.total;document.querySelector('#gallery-'+id+' .ng-track').style.transform='translateX(-'+g.idx*100+'%)';document.querySelectorAll('#gallery-'+id+' .ng-dot').forEach((d,i)=>d.classList.toggle('active',i===g.idx))};
window.goSlide=window.goSlide||function(id,idx){window.galleries[id]={idx,total:document.querySelectorAll('#gallery-'+id+' .ng-slide').length};window.slideGallery(id,0)};
window.openLightbox=window.openLightbox||function(id,idx){const imgs=document.querySelectorAll('#gallery-'+id+' .ng-slide img');document.getElementById('lb-img-'+id).src=imgs[idx].src;document.getElementById('lb-'+id).style.display='flex'};
window.closeLightbox=window.closeLightbox||function(id){document.getElementById('lb-'+id).style.display='none'};
const cid='{{ block.id }}';window.galleries[cid]={idx:0,total:document.querySelectorAll('#gallery-'+cid+' .ng-slide').length};
})();
</script>
{% endif %}

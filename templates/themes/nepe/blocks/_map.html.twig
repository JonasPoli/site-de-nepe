{% set lat = block.config ? (block.config.lat ?? null) : null %}
{% set lng = block.config ? (block.config.lng ?? null) : null %}
{% set zoom = block.config ? (block.config.zoom ?? 14) : 14 %}
{% if lat and lng %}
<div class="nb-map reveal-up">
    {% if block.preTitle or block.title %}
    <div class="nb-section-header" style="margin-bottom:1.5rem">
        {% if block.preTitle %}<span class="pre-label">{{ block.preTitle }}</span>{% endif %}
        {% if block.title %}<h2 class="nb-section-title">{{ block.title }}</h2>{% endif %}
    </div>
    {% endif %}
    <div class="nb-map-frame">
        <iframe
            src="https://maps.google.com/maps?q={{ lat }},{{ lng }}&z={{ zoom }}&output=embed"
            width="100%" height="420" style="border:0;display:block"
            allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade">
        </iframe>
    </div>
</div>
<style>
.nb-map{max-width:1100px;margin:0 auto 4rem;padding:0 1.5rem}
.nb-map-frame{border-radius:var(--radius);overflow:hidden;box-shadow:0 8px 32px rgba(0,0,0,.1);border:1px solid #e8ecf0}
</style>
{% endif %}

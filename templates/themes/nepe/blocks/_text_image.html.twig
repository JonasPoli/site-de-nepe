{% if block.title or block.text or block.preTitle or block.image %}
{% set pos = block.config ? (block.config.imagePosition ?? 'right') : 'right' %}
<div class="nb-text-image {{ pos == 'left' ? 'nti-left' : '' }} reveal-up">
    <div class="nti-text">
        {% if block.preTitle %}<span class="pre-label">{{ block.preTitle }}</span>{% endif %}
        {% if block.title %}<h2 class="nti-heading">{{ block.title }}</h2>{% endif %}
        {% if block.text %}<div class="nti-body prose">{{ block.text|raw }}</div>{% endif %}
        {% if block.config and (block.config.ctaText ?? null) and (block.config.ctaLink ?? null) %}
            <a href="{{ block.config.ctaLink }}" class="cta-btn" style="margin-top:1.75rem">{{ block.config.ctaText }}</a>
        {% endif %}
    </div>
    {% if block.image %}
    <div class="nti-img-wrap">
        <img src="/uploads/page_block/{{ block.image }}" alt="{{ block.title ?? '' }}" loading="lazy" class="nti-img">
    </div>
    {% endif %}
</div>
<style>
.nb-text-image{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center;max-width:1100px;margin:0 auto 4rem;padding:0 1.5rem}
.nti-left .nti-img-wrap{order:-1}
.nti-heading{font-size:1.7rem;font-weight:800;margin:.75rem 0 1rem;color:#1a1c2e;line-height:1.25}
.nti-body{color:#475569;line-height:1.9;font-size:1.05rem}
.nti-body p{margin-bottom:1rem}
.nti-img-wrap{overflow:hidden;border-radius:var(--radius);box-shadow:0 16px 48px rgba(0,0,0,.1);transition:transform .4s ease,box-shadow .4s ease}
.nb-text-image:hover .nti-img-wrap{transform:translateY(-6px);box-shadow:0 24px 60px rgba(0,0,0,.15)}
.nti-img{width:100%;display:block;aspect-ratio:4/3;object-fit:cover;transition:transform .6s cubic-bezier(.2,.8,.2,1)}
.nb-text-image:hover .nti-img{transform:scale(1.04)}
@media(max-width:768px){.nb-text-image{grid-template-columns:1fr;gap:2rem}.nti-left .nti-img-wrap{order:unset}}
</style>
{% endif %}

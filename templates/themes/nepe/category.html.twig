{% extends 'themes/nepe/base.html.twig' %}

{% set isSubCategory = category.parent is not null %}

{% block title %}{{ category.name }}{% endblock %}

{% block meta_description %}
{% if category.description %}
<meta name="description" content="{{ category.description|striptags|slice(0,160) }}">
{% endif %}
{% endblock %}

{% block og_tags %}
{{ parent() }}
<meta property="og:type" content="website">
<meta property="og:title" content="{{ category.name }}">
{% if category.description %}<meta property="og:description" content="{{ category.description|striptags|slice(0,160) }}">{% endif %}
{% endblock %}

{% block body %}

{# ── Hero ── #}
<div class="cat-hero">
    <div class="container cat-hero-inner reveal-up">
        <div class="cat-hero-text">
            {# Breadcrumb para subcategoria #}
            {% if isSubCategory %}
            <nav class="cat-breadcrumb" aria-label="Caminho">
                <a href="{{ path('pub_home') }}">Início</a>
                <span class="cat-breadcrumb-sep">›</span>
                <a href="{{ path('pub_category_show', {slug: category.parent.slug}) }}">{{ category.parent.name }}</a>
                <span class="cat-breadcrumb-sep">›</span>
                <span>{{ category.name }}</span>
            </nav>
            {% else %}
            <nav class="cat-breadcrumb" aria-label="Caminho">
                <a href="{{ path('pub_home') }}">Início</a>
                <span class="cat-breadcrumb-sep">›</span>
                <span>{{ category.name }}</span>
            </nav>
            {% endif %}

            {% if category.preTitle %}
            <span class="vl-badge">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>
                {{ category.preTitle }}
            </span>
            {% endif %}

            <h1>{{ category.name }}</h1>

            {% if category.description %}
            <p class="cat-hero-desc">{{ category.description }}</p>
            {% endif %}
        </div>
    </div>
</div>

{# ── Grid de Subcategorias (apenas para categoria raiz com filhos) ── #}
{% if not isSubCategory and category.children|length > 0 %}
<section class="cat-sub-section">
    <div class="container">
        <div class="section-title reveal-up">
            <h2>Subcategorias</h2>
            <p>Explore os temas dentro de <strong>{{ category.name }}</strong></p>
        </div>
        <div class="cat-sub-grid">
            {% for sub in category.children %}
            <a href="{{ path('pub_category_show', {slug: sub.slug}) }}" class="cat-sub-card reveal-up delay-{{ loop.index0 * 100 }}">
                {# Find the latest image in the blocks of this subcategory #}
                {% set subImage = null %}
                {% for sec in sub.sections %}
                    {% for blk in sec.blocks %}
                        {% if blk.image %}
                            {% set subImage = blk.image %}
                        {% endif %}
                    {% endfor %}
                {% endfor %}

                {% if subImage %}
                <div class="cat-sub-card-img">
                    <img src="/uploads/page_block/{{ subImage }}" alt="{{ sub.name }}" loading="lazy">
                </div>
                {% else %}
                <div class="cat-sub-card-accent"></div>
                {% endif %}
                <div class="cat-sub-card-body">
                    {% if sub.preTitle %}
                    <span class="cat-sub-card-pre">{{ sub.preTitle }}</span>
                    {% endif %}
                    <h3 class="cat-sub-card-title">{{ sub.name }}</h3>
                    {% if sub.description %}
                    <p class="cat-sub-card-desc">{{ sub.description|striptags|slice(0,120) }}{% if sub.description|striptags|length > 120 %}…{% endif %}</p>
                    {% endif %}
                    <span class="cat-sub-card-cta">
                        Ver conteúdo
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </span>
                </div>
            </a>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

{# ── Seções de conteúdo ── #}
{% for section in category.sections %}
    {% if section.active %}
    <section class="page-section">
        {% if section.titlePart1 or section.titlePart2 %}
        <div class="section-two-tone-title reveal-up">
            {% if section.titlePart1 %}
                <span class="title-secondary">{{ section.titlePart1 }}</span>
            {% endif %}
            {% if section.titlePart2 %}
                <span class="title-primary">{{ section.titlePart2 }}</span>
            {% endif %}
        </div>
        {% endif %}

        {% for block in section.blocks %}
        <div class="zigzag-block {% if loop.index is even %}zigzag-reverse{% endif %} reveal-up delay-{{ loop.index0 * 100 }}">
            {% if block.image %}
            <div class="zigzag-img">
                <div class="zigzag-img-wrapper">
                    <img src="/uploads/page_block/{{ block.image }}" alt="{{ block.title ?? '' }}" loading="lazy">
                </div>
            </div>
            {% endif %}
            <div class="zigzag-text {% if not block.image %}zigzag-text--full{% endif %}">
                {% if block.preTitle %}
                    <span class="pre-label">{{ block.preTitle }}</span>
                {% endif %}
                {% if block.title %}
                    <h2>{{ block.title }}</h2>
                {% endif %}
                {% if block.text %}
                    <div class="prose">{{ block.text|raw }}</div>
                {% endif %}
            </div>
        </div>
        {% endfor %}
    </section>
    {% endif %}
{% else %}
    {# Sem seções cadastradas — mensagem vazia elegante #}
    {% if category.sections|length == 0 and (isSubCategory or category.children|length == 0) %}
    <section class="cat-empty-section">
        <div class="container cat-empty-inner reveal-up">
            <div class="cat-empty-icon">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2a10 10 0 100 20A10 10 0 0012 2zm0 6v4m0 4h.01"/></svg>
            </div>
            <p>Conteúdo em breve.</p>
        </div>
    </section>
    {% endif %}
{% endfor %}

{# ── Materiais: Apoio ── #}
{% if catStudies is defined and catStudies|length > 0 %}
<section class="cat-materials-section cat-materials-studies">
    <div class="container">
        <div class="cat-mat-header reveal-up">
            <div class="cat-mat-icon cat-mat-icon--study">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
            </div>
            <div>
                <h2 class="cat-mat-title">Materiais</h2>
                <p class="cat-mat-subtitle">{{ catStudies|length }} {{ catStudies|length == 1 ? 'material' : 'materiais' }} nesta {{ isSubCategory ? 'subcategoria' : 'categoria' }}</p>
            </div>
        </div>
        {% set fallbackImage = null %}
        {% for section in category.sections %}
            {% for block in section.blocks %}
                {% if block.image %}
                    {% set fallbackImage = 'uploads/page_block/' ~ block.image %}
                {% endif %}
            {% endfor %}
        {% endfor %}
        <div class="cat-mat-grid">
            {% for study in catStudies %}
            <a href="{{ path('pub_study_show', {slug: study.slug}) }}" class="cat-mat-card reveal-up delay-{{ (loop.index0 % 4) * 100 }}">
                <div class="cat-mat-card-img">
                    {% if study.coverImage %}
                    <img src="{{ asset('uploads/study_cover/' ~ study.coverImage) }}" alt="{{ study.title }}" loading="lazy">
                    {% elseif fallbackImage %}
                    <img src="{{ asset(fallbackImage) }}" alt="{{ study.title }}" loading="lazy">
                    {% else %}
                    <div class="cat-mat-card-placeholder cat-mat-card-placeholder--study">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                    </div>
                    {% endif %}
                </div>
                <div class="cat-mat-card-body">
                    <span class="cat-mat-card-type cat-mat-card-type--study">Material</span>
                    <h3 class="cat-mat-card-title">{{ study.title }}</h3>
                    {% if study.description %}
                    <p class="cat-mat-card-desc">{{ study.description|striptags|slice(0,100) }}{% if study.description|striptags|length > 100 %}…{% endif %}</p>
                    {% endif %}
                    <span class="cat-mat-card-date">{{ study.createdAt|date('d/m/Y') }}</span>
                </div>
            </a>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

{# ── Materiais: Vídeos ── #}
{% if catVideos is defined and catVideos|length > 0 %}
<section class="cat-materials-section cat-materials-videos">
    <div class="container">
        <div class="cat-mat-header reveal-up">
            <div class="cat-mat-icon cat-mat-icon--video">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            </div>
            <div>
                <h2 class="cat-mat-title">Vídeos</h2>
                <p class="cat-mat-subtitle">{{ catVideos|length }} {{ catVideos|length == 1 ? 'vídeo' : 'vídeos' }} nesta {{ isSubCategory ? 'subcategoria' : 'categoria' }}</p>
            </div>
        </div>
        <div class="cat-mat-grid">
            {% for video in catVideos %}
            <a href="{{ path('pub_video_show', {slug: video.slug}) }}" class="cat-mat-card reveal-up delay-{{ (loop.index0 % 4) * 100 }}">
                <div class="cat-mat-card-img cat-mat-card-img--video">
                    <img src="{{ video.thumbnailUrl }}" alt="{{ video.title }}" loading="lazy">
                    <div class="cat-mat-play-btn">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="white"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                    </div>
                </div>
                <div class="cat-mat-card-body">
                    <span class="cat-mat-card-type cat-mat-card-type--video">Vídeo</span>
                    <h3 class="cat-mat-card-title">{{ video.title }}</h3>
                    {% if video.description %}
                    <p class="cat-mat-card-desc">{{ video.description|striptags|slice(0,100) }}{% if video.description|striptags|length > 100 %}…{% endif %}</p>
                    {% endif %}
                    <span class="cat-mat-card-date">{{ video.createdAt|date('d/m/Y') }}</span>
                </div>
            </a>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

{# ── Materiais: Notícias ── #}
{% if catArticles is defined and catArticles|length > 0 %}
<section class="cat-materials-section cat-materials-news">
    <div class="container">
        <div class="cat-mat-header reveal-up">
            <div class="cat-mat-icon cat-mat-icon--news">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 22h16a2 2 0 002-2V4a2 2 0 00-2-2H8a2 2 0 00-2 2v2"/><path d="M2 10h10M2 14h10M2 18h10M2 6h4"/></svg>
            </div>
            <div>
                <h2 class="cat-mat-title">Notícias</h2>
                <p class="cat-mat-subtitle">{{ catArticles|length }} {{ catArticles|length == 1 ? 'notícia' : 'notícias' }} nesta {{ isSubCategory ? 'subcategoria' : 'categoria' }}</p>
            </div>
        </div>
        <div class="cat-mat-grid">
            {% for article in catArticles %}
            <a href="{{ path('pub_article_show', {slug: article.slug}) }}" class="cat-mat-card reveal-up delay-{{ (loop.index0 % 4) * 100 }}">
                <div class="cat-mat-card-img">
                    {% if article.image %}
                    <img src="{{ ('uploads/article/' ~ article.image)|imagine_filter('news_thumb') }}" alt="{{ article.title }}" loading="lazy">
                    {% else %}
                    <div class="cat-mat-card-placeholder cat-mat-card-placeholder--news">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 22h16a2 2 0 002-2V4a2 2 0 00-2-2H8a2 2 0 00-2 2v2"/><path d="M2 10h10M2 14h10M2 18h10"/></svg>
                    </div>
                    {% endif %}
                </div>
                <div class="cat-mat-card-body">
                    <span class="cat-mat-card-type cat-mat-card-type--news">Notícia</span>
                    <h3 class="cat-mat-card-title">{{ article.title }}</h3>
                    {% if article.shortDescription %}
                    <p class="cat-mat-card-desc">{{ article.shortDescription|striptags|slice(0,100) }}{% if article.shortDescription|striptags|length > 100 %}…{% endif %}</p>
                    {% endif %}
                    <span class="cat-mat-card-date">{{ article.publishedAt ? article.publishedAt|date('d/m/Y') : '' }}</span>
                </div>
            </a>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ── Hero ── */
.cat-hero {
    background: linear-gradient(135deg, var(--color-primary), color-mix(in srgb, var(--color-primary) 60%, var(--color-secondary)));
    color: white; padding: 5rem 0 4rem; position: relative; overflow: hidden;
}
.cat-hero::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(ellipse at 70% 50%, rgba(255,255,255,.08) 0%, transparent 60%);
}
.cat-hero-inner { position: relative; }
.cat-hero-text { max-width: 760px; }
.cat-breadcrumb {
    display: flex; align-items: center; gap: .5rem;
    font-size: .8rem; font-weight: 500; opacity: .75; margin-bottom: 1.5rem;
}
.cat-breadcrumb a { color: white; text-decoration: none; }
.cat-breadcrumb a:hover { opacity: 1; text-decoration: underline; }
.cat-breadcrumb-sep { opacity: .5; }
.cat-breadcrumb span:last-child { opacity: 1; }
.vl-badge {
    display: inline-flex; align-items: center; gap: .4rem;
    background: rgba(255,255,255,.18); backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,.25);
    color: white; font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em;
    padding: .3rem .85rem; border-radius: 50px; margin-bottom: 1rem;
}
.cat-hero-text h1 {
    font-size: clamp(2.2rem, 5vw, 3.5rem); font-weight: 900;
    margin: .4rem 0 1rem; line-height: 1.15;
    text-shadow: 0 2px 12px rgba(0,0,0,.15);
}
.cat-hero-desc {
    font-size: 1.05rem; line-height: 1.7; opacity: .88;
    max-width: 640px; margin: 0;
}

/* ── Subcategory grid ── */
.cat-sub-section { padding: 5rem 0; background: #f8fafc; }
.cat-sub-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem; margin-top: 2.5rem;
}
.cat-sub-card {
    position: relative; background: white; border-radius: var(--radius);
    box-shadow: 0 2px 16px rgba(0,0,0,.06); border: 1px solid rgba(0,0,0,.06);
    overflow: hidden; text-decoration: none; color: inherit;
    display: flex; flex-direction: column;
    transition: transform .25s, box-shadow .25s;
}
.cat-sub-card:hover { transform: translateY(-5px); box-shadow: 0 12px 32px rgba(0,0,0,.12); opacity: 1; }
.cat-sub-card-accent {
    height: 4px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-secondary));
}
.cat-sub-card-img {
    width: 100%; height: 160px; overflow: hidden; position: relative;
    background: #e5e7eb;
}
.cat-sub-card-img img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform .5s cubic-bezier(.2,.8,.2,1);
}
.cat-sub-card:hover .cat-sub-card-img img {
    transform: scale(1.06);
}
.cat-sub-card-body { padding: 1.5rem; display: flex; flex-direction: column; gap: .6rem; flex: 1; }
.cat-sub-card-pre {
    font-size: .7rem; font-weight: 800; text-transform: uppercase; letter-spacing: .09em;
    color: var(--color-primary); opacity: .7;
}
.cat-sub-card-title {
    font-size: 1.15rem; font-weight: 800; margin: 0;
    color: #1a1c2e; line-height: 1.3;
    transition: color .2s;
}
.cat-sub-card:hover .cat-sub-card-title { color: var(--color-primary); }
.cat-sub-card-desc {
    font-size: .875rem; color: #6b7280; line-height: 1.6; margin: 0; flex: 1;
}
.cat-sub-card-cta {
    display: inline-flex; align-items: center; gap: .35rem;
    font-size: .8rem; font-weight: 700; color: var(--color-primary);
    margin-top: .5rem;
    transition: gap .2s;
}
.cat-sub-card:hover .cat-sub-card-cta { gap: .6rem; }

/* ── Seções (reutiliza estilos de page.html.twig) ── */
.page-section { padding: 5rem 0; }
.page-section:nth-child(even) { background: #f8fafc; }
.section-two-tone-title {
    display: flex; justify-content: center; margin-bottom: 3rem; overflow: hidden;
    border-radius: var(--radius);
}
.title-secondary { background: var(--color-secondary); color: #1a1c2e; padding: .75rem 2rem; font-size: 1.4rem; font-weight: 800; }
.title-primary   { background: var(--color-primary);   color: white;   padding: .75rem 2rem; font-size: 1.4rem; font-weight: 800; }
.zigzag-block {
    display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start;
    max-width: 1100px; margin: 0 auto 4rem; padding: 0 1.5rem;
    transition: transform .4s;
}
.zigzag-block:hover { transform: translateY(-5px); }
.zigzag-text--full { grid-column: 1 / -1; max-width: 760px; }
.zigzag-reverse .zigzag-img  { order: 2; }
.zigzag-reverse .zigzag-text { order: 1; }
.zigzag-img-wrapper { overflow: hidden; border-radius: var(--radius); box-shadow: 0 12px 40px rgba(0,0,0,.1); }
.zigzag-img img { width: 100%; display: block; transition: transform .6s cubic-bezier(.2,.8,.2,1); }
.zigzag-block:hover .zigzag-img img { transform: scale(1.05) rotate(-1deg); }
.zigzag-text h2 { font-size: 1.7rem; font-weight: 800; margin: .75rem 0 1rem; transition: color .3s; }
.zigzag-block:hover .zigzag-text h2 { color: var(--color-primary); }
.pre-label {
    display: inline-block; padding: .35rem 1rem; border-radius: 50px; margin-bottom: .75rem;
    background: color-mix(in srgb, var(--color-secondary) 25%, transparent);
    color: var(--color-primary); font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em;
}

/* ── Vazio ── */
.cat-empty-section { padding: 5rem 0; }
.cat-empty-inner { text-align: center; color: #9ca3af; }
.cat-empty-icon { margin-bottom: 1rem; }
.cat-empty-inner p { font-size: 1rem; }

@media (max-width: 768px) {
    .cat-sub-grid { grid-template-columns: 1fr; }
    .zigzag-block { grid-template-columns: 1fr; gap: 2rem; }
    .zigzag-reverse .zigzag-img, .zigzag-reverse .zigzag-text { order: unset; }
    .section-two-tone-title { flex-direction: column; }
    .title-secondary, .title-primary { text-align: center; }
}

/* ── Materiais ── */
.cat-materials-section { padding: 4rem 0; }
.cat-materials-studies { background: #f8fafc; }
.cat-materials-videos  { background: white; }
.cat-materials-news    { background: #f8fafc; }

.cat-mat-header {
    display: flex; align-items: center; gap: 1rem;
    margin-bottom: 2rem; padding-bottom: 1.25rem;
    border-bottom: 2px solid rgba(0,0,0,.06);
}
.cat-mat-icon {
    width: 48px; height: 48px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
}
.cat-mat-icon--study { background: color-mix(in srgb, var(--color-primary) 12%, transparent); color: var(--color-primary); }
.cat-mat-icon--video { background: color-mix(in srgb, #ef4444 12%, transparent); color: #ef4444; }
.cat-mat-icon--news  { background: color-mix(in srgb, var(--color-secondary) 20%, transparent); color: color-mix(in srgb, var(--color-secondary) 80%, #000); }

.cat-mat-title { font-size: 1.4rem; font-weight: 800; margin: 0 0 .15rem; color: #1a1c2e; }
.cat-mat-subtitle { font-size: .85rem; color: #6b7280; margin: 0; }

.cat-mat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.25rem;
}

.cat-mat-card {
    background: white; border-radius: var(--radius);
    box-shadow: 0 2px 12px rgba(0,0,0,.06); border: 1px solid rgba(0,0,0,.05);
    overflow: hidden; text-decoration: none; color: inherit;
    display: flex; flex-direction: column;
    transition: transform .22s, box-shadow .22s;
}
.cat-mat-card:hover { transform: translateY(-4px); box-shadow: 0 10px 28px rgba(0,0,0,.12); opacity: 1; }

.cat-mat-card-img {
    position: relative; width: 100%; height: 148px; overflow: hidden;
    background: #e5e7eb;
}
.cat-mat-card-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s cubic-bezier(.2,.8,.2,1); }
.cat-mat-card:hover .cat-mat-card-img img { transform: scale(1.06); }

.cat-mat-card-img--video { cursor: pointer; }
.cat-mat-play-btn {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    background: rgba(0,0,0,.38); transition: background .2s;
}
.cat-mat-card:hover .cat-mat-play-btn { background: rgba(0,0,0,.55); }
.cat-mat-play-btn svg { filter: drop-shadow(0 2px 4px rgba(0,0,0,.5)); }

.cat-mat-card-placeholder {
    width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
}
.cat-mat-card-placeholder--study { background: color-mix(in srgb, var(--color-primary) 8%, #f8fafc); color: var(--color-primary); opacity: .5; }
.cat-mat-card-placeholder--news  { background: color-mix(in srgb, var(--color-secondary) 10%, #f8fafc); color: color-mix(in srgb, var(--color-secondary) 70%, #000); opacity: .5; }

.cat-mat-card-body {
    padding: 1rem 1.1rem 1.25rem;
    display: flex; flex-direction: column; gap: .4rem; flex: 1;
}
.cat-mat-card-type {
    font-size: .65rem; font-weight: 800; text-transform: uppercase; letter-spacing: .1em;
    padding: .2rem .6rem; border-radius: 50px; display: inline-block; width: fit-content;
}
.cat-mat-card-type--study { background: color-mix(in srgb, var(--color-primary) 12%, transparent); color: var(--color-primary); }
.cat-mat-card-type--video { background: #fee2e2; color: #dc2626; }
.cat-mat-card-type--news  { background: color-mix(in srgb, var(--color-secondary) 20%, transparent); color: color-mix(in srgb, var(--color-secondary) 60%, #000); }

.cat-mat-card-title {
    font-size: .95rem; font-weight: 700; margin: 0; color: #1a1c2e;
    line-height: 1.4; transition: color .2s;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.cat-mat-card:hover .cat-mat-card-title { color: var(--color-primary); }

.cat-mat-card-desc {
    font-size: .8rem; color: #6b7280; line-height: 1.5; margin: 0; flex: 1;
}

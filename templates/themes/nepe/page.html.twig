{% extends 'themes/nepe/base.html.twig' %}

{% block title %}{{ page.seoTitle ?? page.title }}{% endblock %}

{% block meta_description %}
{% if page.seoDescription %}
<meta name="description" content="{{ page.seoDescription }}">
{% endif %}
{% endblock %}

{% block og_tags %}
{{ parent() }}
<meta property="og:type" content="website">
<meta property="og:title" content="{{ page.seoTitle ?? page.title }}">
{% endblock %}

{% block body %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": {{ (page.seoTitle ?? page.title)|json_encode|raw }},
  "url": "{{ app.request.uri }}"
  {% if page.seoDescription %}, "description": {{ page.seoDescription|json_encode|raw }}{% endif %}
}
</script>

{# Page hero #}
<div class="page-hero">
    <div class="container">
        <h1>{{ page.title }}</h1>
    </div>
</div>

{# Sections in zig-zag layout #}
{% for section in page.sections %}
    {% if section.active %}
    <section class="page-section">
        {# Two-part colored title #}
        {% if section.titlePart1 or section.titlePart2 %}
        <div class="section-two-tone-title reveal-up">
            {% if section.titlePart1 %}
                <span class="title-secondary">{{ section.titlePart1 }}</span>
            {% endif %}
            {% if section.titlePart2 %}
                <span class="title-primary">{{ section.titlePart2 }}</span>
            {% endif %}
        </div>
        {% endif %}

        {# Blocks in zig-zag #}
        {% for block in section.blocks %}
        {% if block.type == 'text_only' %}
        {# ── Apenas Texto: full-width, no zigzag grid ─────────────── #}
        {% set align  = block.config ? (block.config.textAlign ?? 'left') : 'left' %}
        {% set mwKey  = block.config ? (block.config.maxWidth ?? 'full') : 'full' %}
        {% set mw     = mwKey == 'narrow' ? '600px' : (mwKey == 'wide' ? '800px' : '100%') %}
        <div class="text-only-block reveal-up delay-{{ loop.index0 * 100 }}" style="text-align:{{ align }};max-width:{{ mw }};">
            {% if block.preTitle %}
                <span class="pre-label">{{ block.preTitle }}</span>
            {% endif %}
            {% if block.title %}
                <h2>{{ block.title }}</h2>
            {% endif %}
            {% if block.text %}
                <div class="prose">{{ block.text|raw }}</div>
            {% endif %}
            {% if block.config and (block.config.ctaText ?? null) and (block.config.ctaLink ?? null) %}
                <a href="{{ block.config.ctaLink }}" class="cta-btn" style="margin-top:1.5rem;display:inline-flex;">{{ block.config.ctaText }}</a>
            {% endif %}
        </div>
        {% elseif block.type == 'banner' %}
        {# ── Banner / Slider ──────────────────────────────────────── #}
        {% set bSlides = [] %}
        {% if block.config.banners is defined and block.config.banners is not empty %}
            {% for b in block.config.banners %}
                {% if (b.active ?? '1') == '1' %}{% set bSlides = bSlides|merge([b]) %}{% endif %}
            {% endfor %}
        {% endif %}
        {% if bSlides is empty and block.title is not empty %}
            {% set bSlides = [{'title': block.title,'text': block.text,'ctaText': block.config.ctaText ?? '','ctaLink': block.config.ctaLink ?? '','image': block.image}] %}
        {% endif %}
        {% if bSlides is not empty %}
        {% if bSlides|length == 1 %}
        {% set b = bSlides[0] %}
        {% set hasContent = b.title or b.text or b.ctaText or block.preTitle %}
        <div class="nepe-banner-block reveal-up">
            {% if b.image %}
                <div class="nbb-bg" style="background-image:url('/uploads/page_block/{{ b.image }}')"></div>
                {% if hasContent %}<div class="nbb-overlay"></div>{% endif %}
            {% else %}
                <div class="nbb-gradient"></div>
            {% endif %}
            {% if hasContent %}
            <div class="nbb-content">
                {% if block.preTitle %}<span class="nbb-pretitle">{{ block.preTitle }}</span>{% endif %}
                {% if b.title %}<h2 class="nbb-title">{{ b.title }}</h2>{% endif %}
                {% if b.text %}<p class="nbb-text">{{ b.text }}</p>{% endif %}
                {% if b.ctaText %}<a href="{{ b.ctaLink ?: '#' }}" class="nbb-cta">{{ b.ctaText }}</a>{% endif %}
            </div>
            {% endif %}
        </div>
        {% else %}
        <div class="nepe-banner-block swiper nbb-swiper-{{ block.id }} reveal-up">
            <div class="swiper-wrapper">
                {% for b in bSlides %}
                <div class="swiper-slide nbb-slide">
                    {% set hasContent = b.title or b.text or b.ctaText or block.preTitle %}
                    {% if b.image %}
                        <div class="nbb-bg" style="background-image:url('/uploads/page_block/{{ b.image }}')"></div>
                        {% if hasContent %}<div class="nbb-overlay"></div>{% endif %}
                    {% else %}
                        <div class="nbb-gradient"></div>
                    {% endif %}
                    {% if hasContent %}
                    <div class="nbb-content">
                        {% if block.preTitle %}<span class="nbb-pretitle">{{ block.preTitle }}</span>{% endif %}
                        {% if b.title %}<h2 class="nbb-title">{{ b.title }}</h2>{% endif %}
                        {% if b.text %}<p class="nbb-text">{{ b.text }}</p>{% endif %}
                        {% if b.ctaText %}<a href="{{ b.ctaLink ?: '#' }}" class="nbb-cta">{{ b.ctaText }}</a>{% endif %}
                    </div>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
            <div class="swiper-pagination swiper-pagination-{{ block.id }}"></div>
            <div class="swiper-button-next swiper-button-next-{{ block.id }}"></div>
            <div class="swiper-button-prev swiper-button-prev-{{ block.id }}"></div>
        </div>
        <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof Swiper !== 'undefined') {
                new Swiper('.nbb-swiper-{{ block.id }}', {
                    loop: true, effect: 'fade', fadeEffect: { crossFade: true },
                    autoplay: { delay: 5000, disableOnInteraction: false },
                    pagination: { el: '.swiper-pagination-{{ block.id }}', clickable: true },
                    navigation: { nextEl: '.swiper-button-next-{{ block.id }}', prevEl: '.swiper-button-prev-{{ block.id }}' }
                });
            }
        });
        </script>
        {% endif %}
        {% endif %}
        {% else %}
        {# ── Default: zigzag (text_image and others) ──────────────── #}
        <div class="zigzag-block {% if loop.index is even %}zigzag-reverse{% endif %} reveal-up delay-{{ loop.index0 * 100 }}">
            {% if block.image %}
            <div class="zigzag-img">
                <div class="zigzag-img-wrapper">
                    <img src="/uploads/page_block/{{ block.image }}" alt="{{ block.title ?? '' }}" loading="lazy">
                </div>
            </div>
            {% endif %}
            <div class="zigzag-text">
                {% if block.preTitle %}
                    <span class="pre-label">{{ block.preTitle }}</span>
                {% endif %}
                {% if block.title %}
                    <h2>{{ block.title }}</h2>
                {% endif %}
                {% if block.text %}
                    <div class="prose">{{ block.text|raw }}</div>
                {% endif %}
            </div>
        </div>
        {% endif %}
        {% endfor %}
    </section>
    {% endif %}
{% endfor %}
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.page-hero {
    background: linear-gradient(135deg, var(--color-primary), color-mix(in srgb, var(--color-primary) 60%, var(--color-secondary)));
    color: white; padding: 5rem 0; text-align: center;
}
.page-hero h1 { font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 900; margin: 0; }
.page-section { padding: 5rem 0; }
.page-section:nth-child(even) { background: #f8fafc; }

.section-two-tone-title {
    display: flex; justify-content: center; margin-bottom: 3rem; overflow: hidden;
    border-radius: var(--radius); transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.section-two-tone-title:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.08);
}
.title-secondary {
    background: var(--color-secondary); color: #1a1c2e;
    padding: 0.75rem 2rem; font-size: 1.4rem; font-weight: 800;
}
.title-primary {
    background: var(--color-primary); color: white;
    padding: 0.75rem 2rem; font-size: 1.4rem; font-weight: 800;
}

.zigzag-block {
    display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start;
    max-width: 1100px; margin: 0 auto 4rem; padding: 0 1.5rem;
    transition: transform 0.4s ease;
}
.zigzag-block:hover {
    transform: translateY(-5px);
}
.zigzag-reverse .zigzag-img { order: 2; }
.zigzag-reverse .zigzag-text { order: 1; }
.zigzag-img-wrapper {
    overflow: hidden; border-radius: var(--radius);
    box-shadow: 0 12px 40px rgba(0,0,0,.1);
}
.zigzag-img img { 
    width: 100%; display: block;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
}
.zigzag-block:hover .zigzag-img img {
    transform: scale(1.05) rotate(-1deg);
}
.zigzag-text h2 { font-size: 1.7rem; font-weight: 800; margin: 0.75rem 0 1rem; transition: color 0.3s; }
.zigzag-block:hover .zigzag-text h2 { color: var(--color-primary); }
.pre-label {
    display: inline-block; padding: 0.35rem 1rem; border-radius: 50px; margin-bottom: 0.75rem;
    background: color-mix(in srgb, var(--color-secondary) 25%, transparent);
    color: var(--color-primary); font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em;
    transition: background 0.3s, transform 0.3s;
}
.zigzag-block:hover .pre-label {
    background: var(--color-secondary);
    transform: scale(1.05);
}

@media (max-width: 768px) {
    .zigzag-block { grid-template-columns: 1fr; gap: 2rem; }
    .zigzag-reverse .zigzag-img, .zigzag-reverse .zigzag-text { order: unset; }
    .section-two-tone-title { flex-direction: column; }
    .title-secondary, .title-primary { text-align: center; }
}

/* ── Apenas Texto (text_only) ──────────────────────────────────────────── */
.text-only-block {
    margin: 0 auto 4rem;
    padding: 0 1.5rem;
}
.text-only-block h2 {
    font-size: 1.7rem; font-weight: 800; margin: 0.75rem 0 1rem;
    color: var(--color-primary);
}
.text-only-block .prose {
    color: #475569; line-height: 1.9; font-size: 1.05rem;
}
.text-only-block .prose p { margin-bottom: 1rem; }
.text-only-block .prose ul, .text-only-block .prose ol { padding-left: 1.5rem; margin-bottom: 1rem; }
.text-only-block .prose li { margin-bottom: .4rem; }
.text-only-block .prose h3 { font-size: 1.2rem; font-weight: 700; margin: 1.5rem 0 .5rem; color: var(--color-primary); }
.text-only-block .prose a { color: var(--color-secondary); text-decoration: underline; }
.text-only-block .prose strong, .text-only-block .prose b { font-weight: 700; }
.cta-btn {
    display: inline-flex; align-items: center; gap: .5rem;
    background: var(--color-primary); color: #fff;
    padding: .75rem 2rem; border-radius: 50px;
    font-weight: 700; font-size: .9rem; text-decoration: none;
    transition: background .2s, transform .2s, box-shadow .2s;
    box-shadow: 0 4px 14px rgba(0,0,0,.15);
}
.cta-btn:hover { background: var(--color-secondary); color: #1a1c2e; transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,.2); }

/* ── Banner / Slider ──────────────────────────────────────────────────────── */
.nepe-banner-block {
    position: relative; overflow: hidden; border-radius: 16px;
    min-height: 380px; margin-bottom: 3rem;
    display: flex; align-items: center; justify-content: center;
    border: 1px solid rgba(255,255,255,.08);
}
.nbb-bg {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    transition: transform .6s ease; z-index: 0;
}
.nepe-banner-block:hover .nbb-bg { transform: scale(1.03); }
.nbb-overlay {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(180deg, rgba(0,0,0,.18) 0%, rgba(0,0,0,.65) 100%);
}
.nbb-gradient {
    position: absolute; inset: 0; z-index: 0;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    opacity: .85;
}
.nbb-content {
    position: relative; z-index: 2; text-align: center;
    max-width: 800px; width: 100%; padding: 3rem 2rem; color: #fff;
    background: rgba(15,23,42,.35); border-radius: 12px;
    backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,.1);
    margin: 2rem auto;
}
.nbb-pretitle {
    display: inline-block; text-transform: uppercase; letter-spacing: 2px;
    font-size: .8rem; font-weight: 700; margin-bottom: 1rem;
    color: var(--color-secondary); background: rgba(0,0,0,.4);
    padding: .35rem 1rem; border-radius: 50px; backdrop-filter: blur(4px);
}
.nbb-title {
    font-size: clamp(1.75rem, 4vw, 2.75rem); font-weight: 900;
    line-height: 1.2; margin-bottom: 1rem;
    text-shadow: 0 2px 10px rgba(0,0,0,.5); color: #fff;
}
.nbb-text {
    font-size: clamp(1rem, 2vw, 1.15rem); opacity: .9;
    line-height: 1.6; margin-bottom: 2rem;
    text-shadow: 0 1px 5px rgba(0,0,0,.4); color: #f1f5f9;
}
.nbb-cta {
    display: inline-flex; align-items: center;
    background: var(--color-primary); color: #fff;
    padding: .8rem 2.2rem; border-radius: 8px;
    font-weight: 700; text-decoration: none;
    box-shadow: 0 4px 15px rgba(0,0,0,.3);
    transition: background .2s, transform .2s;
}
.nbb-cta:hover { background: var(--color-secondary); color: #1a1c2e; transform: translateY(-2px); }
.nbb-slide { position: relative; min-height: 380px; display: flex; align-items: center; justify-content: center; box-sizing: border-box; padding: 1.5rem; }
</style>
{% endblock %}

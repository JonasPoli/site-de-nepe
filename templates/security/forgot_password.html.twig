{% extends 'security/base.html.twig' %}

{% block title %}Esqueci minha senha — NEPE Admin{% endblock %}

{% block content %}
    <h1 class="login-title">Esqueci minha senha</h1>

    {% for message in app.flashes('reset_password_error')|merge(error ? [error] : []) %}
        <div class="alert-err">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/><path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995z"/></svg>
            {{ message }}
        </div>
    {% endfor %}

    <p class="auth-text">Informe o e-mail da sua conta. Vamos enviar um link para você definir uma nova senha.</p>

    <form method="post">
        <div class="field">
            <label for="email">E-mail</label>
            <input type="email" name="email" id="email" autocomplete="email" required autofocus placeholder="seu@email.com">
        </div>

        <input type="hidden" name="_token" value="{{ csrf_token('forgot_password') }}">

        <button class="btn-login" type="submit">Enviar link</button>
    </form>

    <p class="auth-links"><a href="{{ path('app_login') }}">Voltar para o login</a></p>
{% endblock %}

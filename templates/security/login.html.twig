<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Entrar — NEPE Admin</title>
    <link rel="icon" type="image/png" href="{{ asset('images/logo-circulo.png') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
        --bg: #0d0f1a;
        --bg2: #131625;
        --bg3: #1a1e35;
        --border: rgba(255,255,255,.08);
        --text: #e2e8f0;
        --muted: rgba(255,255,255,.45);
        --primary: #7c3aed;
        --primary-light: #a78bfa;
        --danger: #ef4444;
        --radius: 14px;
        --ease: .2s ease;
    }
    body {
        font-family: 'Inter', system-ui, sans-serif;
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        position: relative;
        overflow: hidden;
    }
    /* Background glow */
    body::before {
        content: '';
        position: fixed;
        top: -20%;
        left: 50%;
        transform: translateX(-50%);
        width: 600px;
        height: 600px;
        border-radius: 50%;
        background: radial-gradient(ellipse at center, rgba(124,58,237,.18) 0%, transparent 70%);
        pointer-events: none;
    }
    body::after {
        content: '';
        position: fixed;
        bottom: -10%;
        right: -5%;
        width: 400px;
        height: 400px;
        border-radius: 50%;
        background: radial-gradient(ellipse at center, rgba(79,110,247,.1) 0%, transparent 70%);
        pointer-events: none;
    }

    .login-card {
        background: var(--bg2);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 2.5rem 2rem;
        width: 100%;
        max-width: 380px;
        position: relative;
        z-index: 1;
        box-shadow: 0 24px 64px rgba(0,0,0,.5), 0 0 0 1px rgba(255,255,255,.04);
    }

    .login-logo {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: .75rem;
        margin-bottom: 2rem;
    }
    .login-logo img {
        height: 52px;
        width: auto;
    }
    .login-badge {
        font-size: .72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--primary-light);
        background: rgba(124,58,237,.15);
        border: 1px solid rgba(124,58,237,.25);
        padding: .25rem .75rem;
        border-radius: 50px;
    }

    .login-title {
        font-size: 1.15rem;
        font-weight: 800;
        text-align: center;
        margin-bottom: 1.75rem;
        color: var(--text);
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: .4rem;
        margin-bottom: 1.1rem;
    }
    .field label {
        font-size: .78rem;
        font-weight: 600;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: .05em;
    }
    .field input {
        width: 100%;
        padding: .7rem 1rem;
        border-radius: 9px;
        background: var(--bg3);
        border: 1px solid var(--border);
        color: var(--text);
        font-size: .9rem;
        font-family: inherit;
        outline: none;
        transition: border-color var(--ease), box-shadow var(--ease);
    }
    .field input:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(124,58,237,.15);
    }
    .field input::placeholder { color: var(--muted); }

    .btn-login {
        display: block;
        width: 100%;
        margin-top: 1.5rem;
        padding: .8rem 1.25rem;
        border-radius: 9px;
        background: linear-gradient(135deg, var(--primary), #4f46e5);
        color: #fff;
        font-size: .9rem;
        font-weight: 700;
        font-family: inherit;
        cursor: pointer;
        border: none;
        transition: opacity var(--ease), transform var(--ease), box-shadow var(--ease);
        box-shadow: 0 4px 20px rgba(124,58,237,.4);
        letter-spacing: .02em;
    }
    .btn-login:hover {
        opacity: .92;
        transform: translateY(-1px);
        box-shadow: 0 6px 28px rgba(124,58,237,.55);
    }
    .btn-login:active { transform: translateY(0); opacity: 1; }

    .alert-err {
        padding: .8rem 1rem;
        border-radius: 9px;
        background: rgba(239,68,68,.1);
        border: 1px solid rgba(239,68,68,.25);
        color: #f87171;
        font-size: .85rem;
        font-weight: 500;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: .6rem;
    }

    .logged-in-note {
        font-size: .85rem;
        text-align: center;
        color: var(--muted);
        margin-bottom: 1rem;
    }
    .logged-in-note a { color: var(--primary-light); text-decoration: underline; }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-logo">
            <img src="{{ asset('images/logo-fundo0black.png') }}" alt="NEPE">
            <span class="login-badge">Área Administrativa</span>
        </div>

        {% if error %}
            <div class="alert-err">
                <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/><path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995z"/></svg>
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        {% if app.user %}
            <p class="logged-in-note">
                Logado como <strong>{{ app.user.userIdentifier }}</strong>.
                <a href="{{ path('app_logout') }}">Sair</a>
            </p>
        {% endif %}

        <form method="post" autocomplete="on">
            <div class="field">
                <label for="username">Usuário</label>
                <input type="text" value="{{ last_username }}" name="_username" id="username"
                       autocomplete="username" required autofocus placeholder="seu@email.com">
            </div>
            <div class="field">
                <label for="password">Senha</label>
                <input type="password" name="_password" id="password"
                       autocomplete="current-password" required placeholder="••••••••">
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button class="btn-login" type="submit">Entrar</button>
        </form>
    </div>
</body>
</html>

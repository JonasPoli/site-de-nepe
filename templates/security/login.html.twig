{% extends 'security/base.html.twig' %}

{% block title %}Entrar — NEPE Admin{% endblock %}

{% block content %}
    {% for message in app.flashes('login_success') %}
        <div class="alert-ok">{{ message }}</div>
    {% endfor %}

    {% if error %}
        <div class="alert-err">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/><path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995z"/></svg>
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}

    {% if app.user %}
        <p class="logged-in-note">
            Logado como <strong>{{ app.user.userIdentifier }}</strong>.
            <a href="{{ path('app_logout') }}">Sair</a>
        </p>
    {% endif %}

    <form method="post" autocomplete="on">
        <div class="field">
            <label for="username">Usuário</label>
            <input type="text" value="{{ last_username }}" name="_username" id="username"
                   autocomplete="username" required autofocus placeholder="seu@email.com">
        </div>
        <div class="field">
            <label for="password">Senha</label>
            <input type="password" name="_password" id="password"
                   autocomplete="current-password" required placeholder="••••••••">
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button class="btn-login" type="submit">Entrar</button>
    </form>

    <p class="auth-links"><a href="{{ path('app_forgot_password_request') }}">Esqueci minha senha</a></p>
{% endblock %}

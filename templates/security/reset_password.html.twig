{% extends 'security/base.html.twig' %}

{% block title %}Definir nova senha — NEPE Admin{% endblock %}

{% block content %}
    <h1 class="login-title">Definir nova senha</h1>

    {% if error %}
        <div class="alert-err">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/><path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995z"/></svg>
            {{ error }}
        </div>
    {% endif %}

    <p class="auth-text">Usuário: <strong>{{ user.username }}</strong></p>

    <form method="post">
        {# Ajuda o gerenciador de senhas do navegador a associar a senha ao usuário #}
        <input type="text" name="username" value="{{ user.username }}" autocomplete="username" hidden>

        <div class="field">
            <label for="password">Nova senha</label>
            <input type="password" name="password" id="password" autocomplete="new-password"
                   required minlength="{{ min_length }}" autofocus placeholder="••••••••">
            <span class="field-hint">Mínimo de {{ min_length }} caracteres.</span>
        </div>
        <div class="field">
            <label for="password_confirmation">Repita a nova senha</label>
            <input type="password" name="password_confirmation" id="password_confirmation" autocomplete="new-password"
                   required minlength="{{ min_length }}" placeholder="••••••••">
        </div>

        <input type="hidden" name="_token" value="{{ csrf_token('reset_password') }}">

        <button class="btn-login" type="submit">Salvar senha</button>
    </form>
{% endblock %}

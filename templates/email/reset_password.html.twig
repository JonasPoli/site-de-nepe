{% set primary   = (tenant and tenant.primaryColor) ? tenant.primaryColor : '#6d28d9' -%}
{% set secondary = (tenant and tenant.secondaryColor) ? tenant.secondaryColor : '#f59e0b' -%}
{% set site_name = tenant ? tenant.name : 'NEPE' -%}
{% set logo_url  = (tenant and tenant.logo) ? base_url ~ '/uploads/tenant/logo/' ~ tenant.logo : null -%}
{% set title     = welcome ? 'Boas-vindas ao seu site' : 'Redefinição de senha' -%}
<!DOCTYPE html>
<html lang="pt-BR" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1.0">
    <title>{{ title }} — {{ site_name }}</title>
    <style>
        /* Reset */
        body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
        table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
        img { -ms-interpolation-mode: bicubic; border: 0; outline: none; text-decoration: none; }
        body { margin: 0 !important; padding: 0 !important; background-color: #f0f2f8; }
        a[x-apple-data-detectors] { color: inherit !important; text-decoration: none !important; }

        @media only screen and (max-width: 620px) {
            .wrapper { padding: 16px 8px !important; }
            .hero-cell { padding: 32px 24px 24px !important; }
            .content-cell { padding: 24px !important; }
        }
    </style>
</head>
<body style="margin:0;padding:0;background-color:#f0f2f8;font-family:Arial,Helvetica,sans-serif;">

<!-- Wrapper -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
<tr>
<td class="wrapper" style="padding:40px 16px;background-color:#f0f2f8;">

    <!-- Card -->
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;margin:0 auto;">
    <tr>
    <td style="background:#ffffff;border-radius:20px;overflow:hidden;box-shadow:0 8px 40px rgba(0,0,0,.12);">

        <!-- ── HEADER ── -->
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
        <td class="hero-cell" align="center" style="padding:40px 40px 28px;background-color:#ffffff;">
            {% if logo_url %}
            <img src="{{ logo_url }}" alt="{{ site_name }}"
                 style="max-height:56px;max-width:240px;height:auto;width:auto;display:block;margin:0 auto 20px;">
            {% else %}
            <div style="display:inline-block;background:{{ primary }};border-radius:12px;padding:10px 22px;margin-bottom:20px;">
                <span style="font-size:18px;font-weight:800;color:#ffffff;letter-spacing:.04em;font-family:Arial,Helvetica,sans-serif;">{{ site_name }}</span>
            </div>
            {% endif %}
            <h1 style="margin:0;font-size:22px;font-weight:800;color:#0f172a;font-family:Arial,Helvetica,sans-serif;">{{ title }}</h1>
        </td>
        </tr>
        </table>

        <!-- ── ACCENT BAR ── -->
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
        <td style="height:4px;background-color:{{ primary }};background-image:linear-gradient(90deg,{{ primary }},{{ secondary }});"></td>
        </tr>
        </table>

        <!-- ── CONTENT ── -->
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
        <td class="content-cell" style="padding:36px 40px 32px;">

            <p style="margin:0 0 16px;font-size:15px;color:#374151;line-height:1.7;font-family:Arial,Helvetica,sans-serif;">
                Olá, {{ user.name ?: user.username }}!
            </p>

            {% if welcome %}
            <p style="margin:0 0 24px;font-size:15px;color:#374151;line-height:1.7;font-family:Arial,Helvetica,sans-serif;">
                O site <strong>{{ site_name }}</strong> foi cadastrado e você é a pessoa responsável pela administração.
                Para entrar no painel pela primeira vez, defina sua senha no botão abaixo.
            </p>
            {% else %}
            <p style="margin:0 0 24px;font-size:15px;color:#374151;line-height:1.7;font-family:Arial,Helvetica,sans-serif;">
                Recebemos um pedido para redefinir a senha da sua conta em <strong>{{ site_name }}</strong>.
                Para escolher uma nova senha, use o botão abaixo.
            </p>
            {% endif %}

            <!-- ── Dados de acesso ── -->
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:28px;">
            <tr>
            <td style="padding:16px 18px;background:#f8fafc;border-radius:12px;border:1px solid #e2e8f0;">
                {% if welcome %}
                <span style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1.2px;color:#94a3b8;font-family:Arial,Helvetica,sans-serif;">Endereço do site</span>
                <strong style="display:block;margin:6px 0 14px;font-size:15px;color:#0f172a;word-break:break-all;font-family:Arial,Helvetica,sans-serif;">
                    <a href="{{ base_url }}" style="color:{{ primary }};text-decoration:none;">{{ base_url }}</a>
                </strong>
                {% endif %}
                <span style="display:block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1.2px;color:#94a3b8;font-family:Arial,Helvetica,sans-serif;">Usuário</span>
                <strong style="display:block;margin-top:6px;font-size:15px;color:#0f172a;word-break:break-all;font-family:Arial,Helvetica,sans-serif;">{{ user.username }}</strong>
            </td>
            </tr>
            </table>

            <!-- ── CTA ── -->
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto 28px;">
            <tr>
            <td align="center" style="border-radius:50px;background-color:{{ primary }};">
                <a href="{{ reset_url }}"
                   style="display:inline-block;padding:14px 36px;font-size:14px;font-weight:700;color:#ffffff;text-decoration:none;font-family:Arial,Helvetica,sans-serif;letter-spacing:.04em;border-radius:50px;">
                    {{ welcome ? 'Definir minha senha' : 'Escolher nova senha' }}
                </a>
            </td>
            </tr>
            </table>

            <p style="margin:0 0 12px;font-size:13px;color:#64748b;line-height:1.6;font-family:Arial,Helvetica,sans-serif;">
                O link vale por {{ lifetime_label }} e só pode ser usado uma vez. Se ele expirar, peça outro em
                <a href="{{ login_url }}" style="color:{{ primary }};">{{ login_url }}</a>, na opção “Esqueci minha senha”.
            </p>
            <p style="margin:0;font-size:12px;color:#94a3b8;line-height:1.6;word-break:break-all;font-family:Arial,Helvetica,sans-serif;">
                Se o botão não funcionar, copie e cole este endereço no navegador:<br>
                <a href="{{ reset_url }}" style="color:{{ primary }};">{{ reset_url }}</a>
            </p>

        </td>
        </tr>
        </table>

        <!-- ── DIVIDER ── -->
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
        <td style="padding:0 40px;"><div style="height:1px;background:#e2e8f0;"></div></td>
        </tr>
        </table>

        <!-- ── FOOTER ── -->
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
        <td align="center" style="padding:24px 40px 32px;">
            <p style="margin:0 0 6px;font-size:13px;font-weight:700;color:#374151;font-family:Arial,Helvetica,sans-serif;">{{ site_name }}</p>
            <p style="margin:0;font-size:11px;color:#94a3b8;line-height:1.6;font-family:Arial,Helvetica,sans-serif;">
                {% if welcome %}
                Você recebeu este e-mail porque seus dados foram cadastrados para administrar o site de <strong>{{ site_name }}</strong>.
                {% else %}
                Se você não pediu a redefinição, ignore este e-mail: sua senha continua a mesma.
                {% endif %}
            </p>
        </td>
        </tr>
        </table>

    </td>
    </tr>
    </table>
    <!-- /Card -->

</td>
</tr>
</table>
<!-- /Wrapper -->

</body>
</html>
